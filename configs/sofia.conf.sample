;
; Sofia-SIP Channel Driver Configuration for GABpbx
;
; This file configures chan_sofia, a SIP channel driver built on
; the sofia-sip NUA API. The format is compatible with sip.conf.
;
; Dial string: SOFIA/peername/extension
;   e.g. SOFIA/test100   SOFIA/remote-pbx/1234
;
; Realtime: chan_sofia uses "sippeers" family (same as chan_sip).
; Configure in extconfig.conf:
;   sippeers => sqlite3,/var/lib/gabpbx/sqlite3.db
;
; All commented options below are documented features. The driver has no
; "accepted-but-no-effect" options at this point — every parser key listed
; below maps to a working code path. Aliases noted in §reference.
;

[general]
;
; --- Live SIP tracing (decrypted) -> Homer/HEP + file dump ---------------------
; SIP over ws/wss/tls is encrypted on the wire, so a raw tcpdump only sees ciphertext.
; These options tap sofia-sip's transport layer to expose EVERY SIP message DECRYPTED,
; both directions (recv+sent), for udp/tcp/tls/ws/wss, INCLUDING the SDP body (the WebRTC
; signalling: a=candidate / a=fingerprint / a=setup ...). Off by default (zero overhead).
; The capture socket is non-blocking, so it never stalls the SIP stack.
;
;sip_capture_address = 127.0.0.1:9060   ; stream HEP (UDP) to a Homer/sipcapture server; empty = OFF.
;                                        ; Read it with `sngrep -H udp:127.0.0.1:9060`, Homer, or the
;                                        ; Wireshark HEP dissector. Port must be 1024-65535.
;sip_capture_hep = 3                     ; HEP protocol version 1|2|3 (default 3).
;sip_capture_id = 200                    ; HEP capture-agent id (default 200).
;sip_capture_file = /var/log/gabpbx/sip_trace.txt ; ALSO append every decrypted message to this file
;                                        ; (plain text, no Homer needed); empty = OFF.
;
; Runtime toggles (no reload needed):
;   sip set debug capture <host:port> | capture off
;   sip set debug file <path>         | file off
; A `sip reload` re-applies whatever is set above (a runtime toggle not in this file is then cleared).
;
; Companion protocol tracers (runtime, default OFF, no reload, pure logging — zero datapath):
;   rtp set debug ice        - ICE/DTLS media negotiation: connectivity-check latch, pair
;                              nomination, DTLS handshake state and SRTP setup (WebRTC audio/video).
;   sip set debug fork       - per-Contact INVITE forking: which bindings a call forks to, and why
;                              a leg is added or dropped (mixed udp + ws/wss multi-device debugging).
; Turn either off with `rtp set debug ice off` / `sip set debug fork off`.
;
; Reload behaviour
;
; `sip reload` (and the equivalent `module reload chan_sofia.so`) re-reads
; this file and applies changes to peers, trunks and [general] settings
; without restarting GABPBX. The reload runs on the Sofia-SIP NUA event
; thread itself (no concurrent-traffic crash risk), is serialised against
; itself by a module-level lock, and is bounded by a 30-second timeout.
;
; Listener-level settings are baked into the SIP listener at module load
; and CANNOT be changed by a reload — they require `systemctl restart
; gabpbx` to take effect. The reload reports "listener config changed —
; restart required" and aborts without mutating live state if any of these
; differs from the running value:
;
;   bindaddr, bindport, tlsbindaddr, tlsbindport, tlsenable, tlscertfile,
;   tlscafile, wsbindaddr, wsbindport, wsenable, wssbindaddr, wssbindport,
;   wssenable, tcp_keepalive, tcp_pingpong, timert1, timerb, tlsverify,
;   tlsverifyclient, tls_ciphers, tls_min_version, tls_verify_depth
;
; Peers removed from this file are removed from the in-memory directory on
; reload (mark-and-sweep). Realtime peers are exempt — their lifecycle is
; per-lookup, not file-driven.
;
; Default context for incoming calls
;
context=default

;
; Address and port to bind to (UDP+TCP listener)
; Alias: udpbindaddr accepts "host:port" form (sip.conf compatibility)
;
bindaddr=0.0.0.0
bindport=5080

;
; Realtime sipregs separate-table (sipregs parity)
; ---------------------------------------------------------------------
; chan_sofia auto-detects when extconfig.conf wires the `sipregs` realtime
; family separately from `sippeers`. When detected, registration state
; (ipaddr/port/regseconds/fullcontact/etc.) writes to sipregs while per-peer
; config (secret/context/dtmfmode/etc.) stays in sippeers — chan_sip parity.
; Useful for federated / load-balanced clusters where registration state
; needs cluster-shared storage. NO sofia.conf option keys required —
; pure extconfig.conf-driven auto-detection via ast_check_realtime("sipregs").
; See doc/realtime_sipregs.txt for schema + setup details.
;
; Authentication realm (used in digest challenges; default: gabpbx)
; chan_sofia issues WWW-Authenticate with qop="auth" and supports MD5 plus
; SHA-256 digest verification. Falls back to RFC 2069 form when client omits
; qop in Authorization (permissive backward compat). Per-peer nc replay window
; prevents same-nc reuse. Nonce TTL defaults to 3600s and can be overridden with
; nonce_ttl_seconds below; expired nonce triggers 401 + stale=true.
;
realm=gabpbx

;
; --- auth_algorithms (digest algorithm offer; [general] only, GLOBAL) ---
; Which digest algorithm(s) chan_sofia OFFERS in the WWW-Authenticate challenge.
; This is a GLOBAL switch: the same offer is made to ALL peers — there is no
; per-peer override (one thing to everyone, or the other to everyone). The server
; then accepts ONLY what it offered (a client answering with an algorithm that was
; not advertised is rejected 400), so a sha256-only deployment cannot be silently
; downgraded to MD5.
;
;   both    - offer MD5 + SHA-256 (MD5 listed first for legacy phones; built-in default if unset)
;   md5     - offer MD5 only (chan_sip drop-in parity, maximum handset compatibility)
;   sha256  - offer SHA-256 only (RFC 7616; refuse the weaker MD5)
;
; This file ships md5 ACTIVE (below) for maximum compatibility / chan_sip parity.
; Remove the line to fall back to the built-in default (both = MD5 + SHA-256).
;
; Note: a peer configured with md5secret (a pre-hashed MD5 credential) and no
; plaintext secret can only authenticate with MD5; keep auth_algorithms at md5 or
; both for such deployments, otherwise those peers cannot register.
;
auth_algorithms = md5

;
; --- auth_qop (digest challenge qop form; [general] only, GLOBAL) ---
; Controls the MD5 WWW-Authenticate challenge form. Affects the MD5 challenge ONLY;
; SHA-256 always keeps qop="auth" (RFC 7616).
;
;   no   - chan_sip legacy challenge (RFC 2069): "Digest algorithm=MD5, realm=..., nonce=..."
;          with NO qop. This is the DEFAULT (built-in), for maximum drop-in chan_sip
;          compatibility — some older handsets only authenticate against this exact form.
;   yes  - modern challenge (RFC 2617/7616): "Digest realm=..., nonce=..., qop=\"auth\",
;          algorithm=MD5", enabling nc/cnonce replay protection.
;
; ****************************  SECURITY WARNING  ****************************
; auth_qop=no (the default) uses RFC 2069 digest, which has NO REPLAY PROTECTION:
; there is no nc/cnonce and the per-nonce replay gate is bypassed, so a captured
; Authorization header can be replayed. This matches chan_sip (which is also no-qop).
; It is only truly confidential when the SIP signaling is itself protected (TLS/WSS/VPN).
; Set auth_qop=yes if your handsets support it and you want replay protection.
; With auth_algorithms=md5 + auth_qop=no the challenge is byte-for-byte chan_sip's.
; ***************************************************************************
;
;auth_qop = no      ; (built-in default) chan_sip legacy, no replay protection
;auth_qop = yes     ; RFC 2617/7616 qop="auth" (replay-protected) — needs handset support

;
; Allow guest calls (calls from unknown peers)
; Default: yes
;
allowguest=yes

;
; Local anti-abuse blacklist (fail2ban-style). Repeated authentication / registration / routing
; failures from the same source IP are counted; once the threshold is reached the IP is blocked at
; the gate. Inspect/manage it with the `sip show blacklist` / `sip blacklist ...` CLI.
;
; blacklist_ban — how long (in MINUTES) a blocked IP stays banned after its last failure, and how
;                 long an accumulating failure counter is remembered before it is forgiven.
;                 Default: 1440 (24 hours). 0 = banning DISABLED (no IP is ever blocked or counted).
;                 Applied live on `sofia reload` (no restart).
;
;blacklist_ban = 1440     ; minutes; default 1440 = 24h; 0 = disable banning

;
; SRV lookup for outbound calls
; Default: yes
;
srvlookup=yes

;
; --- TLS / WS / WSS listeners — optional ---
; tlsbindaddr  = 0.0.0.0
; tlsbindport  = 5061                         ; non-zero sets the TLS listener port
; tlsenable    = yes                          ; explicit on/off for the TLS listener (default yes).
;                                              ; tlsenable=no disables TLS even if tlsbindport is set
;                                              ; (chan_sip parity). Same idea: wsenable, wssenable.
; tlscertfile  = /etc/gabpbx/keys             ; cert DIR, OR the real cert+key FILE (alias: tlscertdir).
;                                              ; If it names a FILE (e.g. /etc/gabpbx/keys/gabpbx.pem),
;                                              ; chan_sofia uses its directory and soft-links the name
;                                              ; sofia-sip expects (agent.pem) to that file - so you can
;                                              ; point straight at a cert managed by an external tool
;                                              ; without renaming it.
; tlscafile    = /etc/gabpbx/keys/ca.crt       ; optional real CA file; soft-linked to <dir>/cafile.pem.
;
; TLS hardening (TLS listener only): tls_min_version defaults to 1.2 even when unset (see below); every
; OTHER knob here is opt-in and keeps the sofia-sip default when unset:
; tls_min_version  = 1.2                       ; minimum TLS version 1.0|1.1|1.2|1.3 (enables that
;                                              ; version and every higher one). DEFAULT 1.2 — the TLS
;                                              ; listener accepts TLS 1.2 and 1.3 out of the box. A
;                                              ; previous 1.3-only default rejected endpoints that cap
;                                              ; at TLS 1.2; set 1.3 here to refuse 1.2 again, or 1.0/1.1
;                                              ; to re-admit legacy handshakes.
; tls_ciphers      = ECDHE+AESGCM:!aNULL:!MD5  ; OpenSSL cipher list (unset = sofia default
;                                              ; "!eNULL:!aNULL:!EXP:!LOW:!MD5:ALL:@STRENGTH").
; tls_verify_depth = 3                         ; max peer cert-chain depth (unset/0 = sofia default 2).
; tlsverify         = no                       ; verify the SERVER cert on OUTBOUND TLS connections
;                                              ; (accepted alias: tlsverifyserver). ORed with
;                                              ; tlsverifyclient below into one verify policy. Default no;
;                                              ; uses the same CA material as tlsverifyclient (tlscertfile).
; tlsverifyclient  = yes                       ; mutual TLS (mTLS): also verify the CLIENT cert on the
;                                              ; INBOUND TLS listener. ORed with tlsverify's outbound
;                                              ; server-cert check into ONE policy (both set -> verify
;                                              ; both directions). Default no. A client without a
;                                              ; CA-trusted cert then fails the TLS handshake before any
;                                              ; SIP. Uses the same CA material as tlsverify (tlscertfile).
;                                              ; Per-subject pinning (an allowlist) is a documented v2
;                                              ; follow-up (TPTAG_TLS_VERIFY_SUBJECTS).
; NOTE: these harden the TLS listener ONLY — the WSS listener builds its own SSL_CTX (which already
; disables SSLv2/SSLv3/TLSv1) and ignores these knobs. Changing any of tlsverify / tlsverifyclient /
; tls_min_version / tls_ciphers / tls_verify_depth needs `systemctl restart gabpbx` (a `sip reload` refuses with
; "listener config changed").
;
; ws-binding for browser SIP UAs (no TLS; no cert needed)
; wsbindaddr   = 0.0.0.0
; wsbindport   = 5066                         ; non-zero sets the WS listener port
; wsenable     = yes                          ; explicit on/off for the WS listener (default yes)
;
; wss-binding (recommended for production browser UAs; reuses tlscertfile)
; wssbindaddr  = 0.0.0.0
; wssbindport  = 7443                         ; non-zero sets the WSS listener port
; wssenable    = yes                          ; explicit on/off for the WSS listener (default yes)
;
; NOTE: TLS expects agent.pem (combined cert+key) + cafile.pem (CA cert) in the tlscertfile dir;
; WSS additionally needs wss.pem + ca-bundle.crt. chan_sofia AUTO-LINKS the missing names at
; startup: agent.pem -> tlscertfile (if it is a file), cafile.pem -> tlscafile, wss.pem -> agent.pem,
; ca-bundle.crt -> cafile.pem (soft links, created only if missing, never overwriting your files).
; So you only manage the real cert + CA; chan_sofia bridges them to the names sofia-sip opens.
; IMMUNITY: if a configured TLS/WSS listener has NO usable certificate, chan_sofia logs an ERROR and
; DISABLES only that listener (UDP/TCP/WS keep serving and the module still loads) instead of failing
; the whole driver. Set tlsenable=no / wssenable=no to silence the warning on a box with no cert.
; Generate self-signed for testing:
;   openssl req -x509 -newkey rsa:2048 -keyout key.pem -out cert.pem -days 365 -nodes -subj "/CN=mypbx"
;   cat cert.pem key.pem > /etc/gabpbx/keys/agent.pem
;   cp cert.pem /etc/gabpbx/keys/cafile.pem
; WebRTC media (DTLS-SRTP + ICE-lite + BUNDLE + rtcp-mux) IS supported — set webrtc=yes (see (4) below).
;
; --- Connection keepalive (TCP) — optional ---
; For connection-oriented transports, sofia-sip already keeps the OS socket alive with SO_KEEPALIVE
; (~30s) by default, so a TCP/TLS/WS phone behind NAT keeps a live socket out of the box (this matches
; chan_sip, which set SO_KEEPALIVE per session). To ALSO refresh the NAT mapping at the SIP layer,
; enable a periodic CRLF keepalive on idle connections:
;   tcp_keepalive  - seconds between CRLF keepalives on an idle connection (0 = off, the default).
;                    Sends a double-CRLF ping (RFC 5626 §3.5.1) on idle TCP connections so the NAT
;                    binding stays open and an inbound request still reaches the phone. TCP ONLY —
;                    TLS/WS connections rely on the SO_KEEPALIVE socket option above. A common
;                    NAT-friendly value is 30.
;   tcp_pingpong   - seconds to wait for a pong after a keepalive ping before treating the connection
;                    as dead and closing it (0 = off, the default). Requires tcp_keepalive (it is
;                    ignored, with a warning, if keepalive is off). Use with care: an aggressive value
;                    can drop a slow-but-alive connection.
;tcp_keepalive = 0
;tcp_pingpong = 0
;
; --- WS+WSS deployment guidance ---
;
; (1) ORIGIN HEADER VALIDATION (RFC 7118 §4.1.4) — DELEGATED TO REVERSE-PROXY:
;     The underlying sofia-sip ws.c does NOT validate the WebSocket Origin
;     header. For cross-origin protection, deploy chan_sofia BEHIND a reverse
;     proxy (nginx, Caddy, HAProxy) that enforces an Origin allowlist. Example
;     nginx config snippet:
;       map $http_origin $origin_ok { default 0; "https://pbx.example.com" 1; }
;       server {
;         listen 443 ssl http2;
;         location /sip {
;           if ($origin_ok = 0) { return 403; }
;           proxy_pass http://127.0.0.1:5066;       ; chan_sofia wsbindport
;           proxy_http_version 1.1;
;           proxy_set_header Upgrade $http_upgrade;
;           proxy_set_header Connection "upgrade";
;           proxy_set_header Host $host;
;           proxy_set_header X-Forwarded-For $remote_addr;
;         }
;       }
;     chan_sofia exposes wsbindport on localhost; nginx terminates TLS + enforces
;     Origin. chan_sofia does NOT enforce Origin
;     directly; reverse-proxy is the recommended chan_sofia deployment pattern.
;
; (2) Sec-WebSocket-Protocol — LENIENT ECHO (sofia-sip ws.c:304/315):
;     sofia-sip echoes any client-offered Sec-WebSocket-Protocol value without
;     strict validation. RFC 7118 §4.2 prescribes the literal "sip" subprotocol;
;     chan_sofia accepts any echo (lenient). Operators relying on strict
;     subprotocol negotiation should enforce at the reverse-proxy via
;     `if ($http_sec_websocket_protocol != "sip") { return 400; }` or similar.
;     For signaling-only deployments behind a reverse-proxy, lenient acceptance
;     is safe (the reverse-proxy gates connection establishment).
;
; (3) BROWSER SIP STACK EXAMPLES — sip.js + JsSIP:
;     chan_sofia ships SIP signaling over WS+WSS AND full WebRTC media. Browser
;     clients using sip.js or JsSIP work both ways: plain RTP / SDES-SRTP, and
;     native WebRTC media (DTLS-SRTP + ICE + BUNDLE + rtcp-mux) when the peer has
;     webrtc=yes — see (4) below.
;
;     sip.js (https://sipjs.com/) minimal config:
;       const ua = new SIP.UserAgent({
;         uri: SIP.UserAgent.makeURI("sip:alice@pbx.example.com"),
;         transportOptions: {
;           server: "wss://pbx.example.com:7443",
;           connectionTimeout: 10
;         },
;         authorizationUsername: "alice",
;         authorizationPassword: "secret"
;       });
;       ua.start();
;     Cert-pinning: production deployments should pin the WSS cert via the
;     browser's HSTS/HPKP infrastructure (handled by reverse-proxy TLS).
;
;     JsSIP (https://jssip.net/) minimal config:
;       const socket = new JsSIP.WebSocketInterface("wss://pbx.example.com:7443");
;       const config = {
;         sockets: [socket],
;         uri: "sip:alice@pbx.example.com",
;         password: "secret"
;       };
;       const ua = new JsSIP.UA(config);
;       ua.start();
;
; (4) WEBRTC MEDIA — set webrtc=yes (per-peer, or in [general] so all peers inherit it):
;     chan_sofia speaks native WebRTC media end-to-end. A browser
;     RTCPeerConnection (and sip.js / JsSIP using WebRTC media) registers over
;     WSS and gets two-way audio — including browser-to-browser bridged by gabpbx.
;       - DTLS-SRTP (RFC 5763/5764) — SRTP keys from the DTLS handshake
;       - ICE-lite (RFC 8445 §2.5) — gabpbx answers connectivity checks; the
;         browser is the full-ICE controlling agent
;       - IMMEDIATE MEDIA LATCH (RFC 8445 §7.3.1 / RFC 7675) — the ICE media
;         tuple is latched on EVERY integrity-authenticated connectivity check,
;         not only the nominated pair. This removes the intermittent one-way or
;         10-20s-delayed audio, and the deaf inbound call to a browser, that a
;         nominate-only latch could otherwise produce. No configuration needed.
;       - BUNDLE + rtcp-mux (RFC 8843 / RFC 5761) — one 5-tuple for RTP+RTCP
;       - audio always; VIDEO optional — set allow=vp8 and/or allow=h264 on the peer.
;         Accepted video runs on its OWN separate non-BUNDLE DTLS/ICE transport
;         (RFC 8843 §7), so a browser audio+video offer gets two-way video. If the
;         browser forces bundlePolicy:max-bundle (a=bundle-only on m=video), video
;         falls back to audio-only — no regression. gabpbx BOTH ACCEPTS an inbound browser
;         video offer (answerer) AND OFFERS video on an outbound leg (offerer) when the peer's
;         allow= has vp8/h264, so two-way browser-to-browser video works. (Preserving video
;         across a later local re-offer/hold is a follow-up.) DTLS/ICE security per RFC 8827.
;     webrtc=yes is only the ENABLE/permission for DTLS-SRTP (DTLS+ICE). The actual OUTBOUND media
;     profile is ALWAYS chosen by the TARGET's physical transport, never forced by webrtc=yes:
;       - a contact registered over ws/wss            -> UDP/TLS/RTP/SAVPF (DTLS-SRTP)
;       - a contact registered over udp/tcp/tls       -> RTP/AVP (or RTP/SAVP with encryption=yes)
;       - a static peer (host!=dynamic)               -> by its configured transport= (ws/wss -> DTLS, else RTP)
;     So ONE account can be used from several phones at once with DIFFERENT technologies - a wss browser,
;     a udp phone and a tls phone registered simultaneously - and EACH contact is served per its own
;     transport (gabpbx forks an INVITE per contact). A udp/tls target is NEVER offered DTLS-SRTP even
;     with webrtc=yes set explicitly (a plain phone would reject it 406/488). webrtc=no (per-peer) fully
;     disables DTLS for that peer. A realtime backend with no per-peer webrtc column needs no change:
;     WebRTC is auto-detected from each contact's ws/wss registration. An inbound SAVPF/DTLS offer still
;     engages the WebRTC answerer path as before (the answer mirrors the offer).
;
;     ICE-lite REQUIRES the server's media address be reachable by the browser:
;     on a NAT'd host set externip / media_address to the public IP. Full ICE
;     candidate gathering + TURN for a server behind NAT is a future item — until
;     then deploy gabpbx with a public-reachable media address (or a media relay).
;
;     WEBRTC DATACHANNEL (RFC 8831/8832/8841) — set datachannel=yes:
;       datachannel=yes makes chan_sofia ACCEPT the m=application SCTP DataChannel
;       a browser offers alongside its audio (the "ondatachannel"/createDataChannel
;       API). It rides the SAME BUNDLE'd audio ICE+DTLS transport (no extra port or
;       socket; SCTP-over-DTLS per RFC 8841) and lets gabpbx bridge DataChannels
;       between two WebRTC legs. REQUIRES webrtc=yes AND a gabpbx built WITH usrsctp;
;       without both, the m=application is reflected at port 0 (the browser sees the
;       DataChannel declined) and audio/video are unaffected. DEFAULT no — leaving it
;       off is byte-identical to a gabpbx with no DataChannel support, so it is safe
;       in [general] for a mixed fleet. Per-peer datachannel= overrides [general].
;
;     WEBRTC VIDEO BUNDLE (RFC 8843 max-bundle) — set webrtc_video_bundle=yes:
;       webrtc_video_bundle=yes makes chan_sofia carry WebRTC VIDEO on the SAME
;       BUNDLE'd audio ICE+DTLS transport (one m=video at the audio port, listed in
;       a=group:BUNDLE, PT-demuxed, with no separate video ICE/DTLS/fingerprint) —
;       which is what modern browsers negotiate (max-bundle). With it OFF, video
;       uses a separate transport that max-bundle browsers refuse to key, giving
;       one-way / black video. REQUIRES webrtc=yes. DEFAULT no — off is byte-identical
;       to today's separate-transport video. Per-peer webrtc_video_bundle= overrides
;       [general].
;
; (5) chan_sofia advantage over chan_sip on WS+WSS:
;     chan_sip has NO WebSocket support whatsoever (0 hits in chan_sip.c for
;     websocket / RFC 7118 / wsbindport). chan_sofia adds:
;       - WS + WSS listeners
;       - transport=ws / transport=wss per-peer parser
;       - sip show peer / sip show settings / AMI SIPshowpeer Transport display
;       - per-peer transport= sets the OUTBOUND transport for static peers (unknown values fall back to udp)
;       - WSS auto-cert-link from agent.pem + cafile.pem
;       - this WS+WSS deployment guidance
;     chan_sip operators with browser-UA needs migrate to chan_sofia for WS+WSS
;     — and now full WebRTC media (see (4) above).
;
; --- end WS+WSS deployment guidance ---

;
; External address for NAT traversal — substituted into SDP o= and c= lines
; for peers OUTSIDE the localnet ranges below. Lets WAN clients reach RTP
; through 1:1 NAT or SBC. RTP socket bind unchanged (still local interface).
; Alias: externhost (separate semantics NAT parity fill —
; externhost = DDNS hostname (lazy-resolved to externaddr per externrefresh);
; externaddr = static IP). Backwards-compat: externaddr=hostname auto-detected
; + routed to externhost path (lenient parser; existing operator scripts unchanged).
;externaddr=203.0.113.1
;externip=203.0.113.1          ; chan_sip alias of externaddr (literal external IP) — drop-in parity
;externhost=mypbx.dyndns.net   ; DDNS WAN hostname; chan_sofia re-resolves periodically per externrefresh
;externrefresh=10              ; DNS-refresh interval in seconds (default 10; chan_sip parity)
;externtcpport=5060            ; external TCP port for outbound headers (default 5060; 0 = use externaddr port)
;externtlsport=5061            ; external TLS port for outbound headers (default 5061)
;
; Local network ranges — peers matching ANY localnet keep the local socket
; address in SDP. Peers outside ALL ranges get externaddr substitution.
; Repeat the directive for multiple ranges (CIDR notation).
;localnet=192.168.0.0/24
;localnet=10.0.0.0/8
;
; media_address (chan_sip parity): a global media-interface address advertised in the SDP c=/o= lines
; (audio, video and T.38) INSTEAD of the kernel-routed source — for multi-homed hosts where media must
; leave a different interface/IP than signaling. It is ADVERTISE-ONLY: the RTP sockets still bind
; bindaddr; only the address offered to the far end changes. It WINS over externaddr/externip (a
; deliberate operator override); directmedia still redirects to the bridged peer. Empty = off.
;media_address=198.51.100.20
;
; recordhistory: boot default for per-call SIP history recording (default no = zero overhead). When on,
; each call records a bounded ring of signalling events (Tx/Rx, state, hangup) inspectable with
; 'sip show history <call-id>'; the last completed calls are retained for after-hangup inspection, and
; 'sip show history <call-id> verbose' adds an analysis block (outcome, failure reason, timeline,
; negotiated codecs). A runtime 'sip set history on|off' toggle persists across a reload unless this
; knob re-applies. 'sip history clear' discards the retained calls. On a busy system,
; 'sip set history on <match>' records only calls whose source or destination contains the
; case-insensitive substring <match> (e.g. 'sip set history on 960800120' or '... on alice').
;recordhistory=no

;
; Default qualify settings for all peers
; These are used when peer has qualify=yes but no explicit values
;
;qualify=yes
;qualifyfreq=60
;qualifytimeout=3

;
; Busy-on-active: reject new calls with 486 Busy Here when any device on
; this account is already in a call. Default: no.
;
;busy_on_active = no
;
; Max simultaneous registered devices per peer.
; Range [1, 6], default 6, hard ceiling 6.
;
;max_contacts   = 6

;
; --- Per-Contact REGISTER (RFC 3261 §10.3) ---
; A peer may hold several Contact bindings at once (up to max_contacts). Each
; Contact is INDEPENDENT: it binds, refreshes and de-registers on its own and
; honours its own ;expires — a Contact sent with expires=0 removes ONLY that one
; binding, and the 200 OK reports each binding's own remaining expiry. Inspect the
; live set with `sip show peer <name> detail`, which shows every binding and its
; state (AVAILABLE / EXPIRED / IN-CALL). A call to a peer whose bindings have ALL
; expired returns CHANUNAVAIL instead of routing to a stale binding.
;
; --- Identity headers (identity-headers parity, RFC 3325 + RFC 3323) ---
; chan_sip drop-in defaults — peers omitting callingpres / sendrpid / trustrpid
; inherit from this [general] block. Per-peer keys override.
;
; callingpres   - default presentation for outbound calls. Accepted values mirror
;                 chan_sip exactly (see callerid.h AST_PRES_* table):
;                   allowed_not_screened   (DEFAULT — Allowed, Not Screened)
;                   allowed_passed_screen  (Allowed, Passed Screen)
;                   allowed_failed_screen  (Allowed, Failed Screen)
;                   allowed                (Allowed, Network Number)
;                   prohib_not_screened    (Prohibited, Not Screened)
;                   prohib_passed_screen   (Prohibited, Passed Screen)
;                   prohib_failed_screen   (Prohibited, Failed Screen)
;                   prohib                 (Prohibited, Network Number)
;                   unavailable
; sendrpid      - outbound RPID/PAI emission mode. Default: no.
;                   no    - no PAI / no RPID (chan_sip default)
;                   pai   - emit P-Asserted-Identity (RFC 3325)
;                   rpid  - emit Remote-Party-ID (legacy RFC draft)
; trustrpid     - trust inbound PAI / RPID and apply caller-id from them.
;                 Default: no. Set yes only for trusted upstream proxies / SBCs.
;
;callingpres    = allowed_not_screened   ; named presentation OR a raw numeric value (chan_sip parity)
;sendrpid       = no                      ; no / pai / rpid (yes = rpid)
;trustrpid      = no

;
; --- Call-limit (call-limit parity) ---
; Trunk capacity control — essential for PBX-to-PBX deployments. chan_sip parity
; key names: callcounter / call-limit / busylevel. Inbound INVITE rejected with
; 480 Temporarily Unavailable (Call limit) when inUse >= call-limit; outbound dial
; returns AST_CAUSE_USER_BUSY (486 Busy Here equivalent).
;
; callcounter   - shorthand: yes -> unlimited counter participation (call-limit
;                 = INT_MAX, 480 enforcement disabled but inUse/inRinging/onHold
;                 still tracked for sip show inuse + AMI). Default: no.
; call-limit    - hard cap on simultaneous calls; 0 = unlimited. Default: 0.
;                 (alias accepted: call_limit — for operator-friendly drop-in)
; busylevel     - soft cap; outbound returns BUSY when inUse >= busy_level
;                 (allows graceful overflow before hard reject). Default: 0.
;
;callcounter    = no
;call-limit     = 0
;busylevel      = 0

;
; --- allowtransfer per-peer (chan_sip parity, drop-in REFER policy) ---
; Gate inbound SIP REFER (call-transfer requests). When set to "no"/"false",
; chan_sofia rejects every REFER from the peer with 603 Declined (policy) and
; never processes the transfer body. Default "yes" matches chan_sip backwards-
; compat ("Merrily accept all transfers" — chan_sip.c:29476). Set per-peer in
; [peer] section to override; or set this default to "no" plus opt-in trusted
; peers individually (typical PBX-hardening posture).
;
; REFER is an attack surface — a misbehaving or
; compromised peer can use REFER to redirect active calls (call spam, redirect
; to attacker-controlled URIs, premium-rate fraud). Per-peer allowtransfer=no
; on untrusted/external trunks closes that vector while keeping internal
; extensions free to use *2 attended-transfer / blind-transfer keys.
;
; chan_sofia extension: when REFER is rejected by this gate, an AMI event
; "TransferRejected" fires (Channel + Uniqueid + Peer + ReferTo + Reason)
; for real-time NMS monitoring of REFER-abuse attempts. chan_sip silently
; rejects with history-only logging (no AMI signal).
;
;default_allowtransfer = yes    ; yes = allow REFER (chan_sip default); no = reject 603 Declined (policy)
;allowtransfer         = yes    ; bare key alias accepted in [general] (chan_sip MOH-style leniency)
;
; allowtransfer gates INBOUND REFER only. chan_sofia can also ORIGINATE a REFER to
; push a connected call away (outbound transfer), from the dialplan:
;   SofiaTransfer(<peer-or-uri>[,<replaces>])   ; blind, or attended when <replaces> is given
;       <replaces> = "callid;to-tag=X;from-tag=Y" (percent-encoded into Refer-To)
;   Transfer(<dest>)                            ; the standard blind-transfer app (needs app_transfer);
;                                               ; chan_sofia's .transfer callback emits the REFER
; Outbound REFER is your own dialplan's decision, so it is NOT gated by allowtransfer.
; The transfer result returns to the dialplan via the refer NOTIFY (sipfrag 2xx = success),
; with a 30s backstop so Transfer() never blocks forever. One outbound REFER per dialog at a time.

;
; --- allowsubscribe (chan_sip parity, drop-in SUBSCRIBE policy) ---
; A REQUEST-EVENT gating sibling to allowtransfer — gates inbound
; SIP SUBSCRIBE (presence/MWI/dialog event subscriptions). When [general]
; allowsubscribe=no AND every peer has allowsubscribe=no, chan_sofia rejects
; every SUBSCRIBE upfront with 403 Forbidden (policy) — chan_sip parity at
; chan_sip.c:25856 global ban gate. Per-peer allowsubscribe=no rejects per-peer
; with the same 403 string (chan_sip parity at chan_sip.c:25940). Default yes
; per chan_sip drop-in (sip.h:478 SIP_PAGE2_ALLOWSUBSCRIBE default TRUE — "Default
; for all devices: TRUE"). chan_sip operator scripts with allowsubscribe= migrate
; verbatim zero-rewrite.
;
; chan_sofia extension: when SUBSCRIBE is rejected by this gate, an AMI event
; "SubscribeRejected" fires (Peer + Event + Reason:AllowSubscribeClosed +
; RemoteAddr + ChannelType:SIP) for real-time NMS monitoring of subscribe-abuse
; attempts. chan_sip silent on these paths. Note: GabPBX has no
; EVENT_FLAG_SECURITY class, so the event ships under EVENT_FLAG_SYSTEM matching
; existing chan_sofia AMI events.
;
;allowsubscribe = yes    ; default; chan_sip drop-in (sip.h:478 default TRUE)

;
; --- Outbound PUBLISH (RFC 3903) — publish dialog/BLF state to a CENTRAL presence server ---
; chan_sofia can act as an Event Publication Agent (EPA): for each peer with `publish=yes`, it sends a
; SIP PUBLISH (application/dialog-info+xml by default, or PIDF — see publish_format) carrying that peer's hint state to a central Event State
; Compositor (ESC) such as Kamailio's presence module — so the ESC can NOTIFY watchers across a cluster
; or federation. chan_sip never had this. The feature is OFF until `publish_server` is set,
; and validated end-to-end against a real Kamailio ESC.
;
; The peer's published presentity is sip:<exten>@<publish_domain>, where <exten> is the peer's
; `publish_exten` (if set) else `regexten` (or its name), and the state comes from the peer's
; `subscribecontext` dialplan hint — so a published peer needs that exten + `subscribecontext` + a real
; hint (no auto-create).
;
; A `sip reload` reconciles publications live: it adds peers that gained publish=yes, removes (with an
; Expires:0 unpublish to the server) peers that dropped it, and rebuilds when publish_server/domain/
; expires/format change — no restart needed. (Only a listener change, e.g. bindport/TLS, is restart-required.)
;
;publish_server   = sip:presence.example.com:60000  ; central ESC host[:port]. Empty = feature OFF. The
;                                                    ; ESC's SIP port is used in the PUBLISH Request-URI,
;                                                    ; so set it explicitly if the ESC is not on :5060.
;publish_domain   = example.com                     ; presentity domain in sip:<exten>@<domain>. Default:
;                                                    ; the publish_server host. Use the domain your ESC
;                                                    ; serves/normalizes so it accepts the presentity.
;publish_expires  = 3600                            ; PUBLISH Expires in seconds (default 3600; min 30).
;                                                    ; Must be >= the ESC's min_expires, else the ESC 423s
;                                                    ; and chan_sofia retries with the returned Min-Expires.
;publish_username = pbxpublisher                     ; digest credentials, only if the ESC challenges the
;publish_password = s3cr3t                           ; PUBLISH with 401/407 (trusted-IP ESCs need neither).
;publish_format   = dialog-info                      ; PUBLISH body: dialog-info (RFC 4235, default — call
;                                                    ; state early/confirmed/terminated, Event: dialog) or
;                                                    ; pidf (RFC 3863 presence open/closed/busy, Event:
;                                                    ; presence, application/pidf+xml). Global; the ESC must
;                                                    ; support the chosen event package. Changing it on
;                                                    ; reload full-rebuilds publications (new Event + ETag).
;publish_transport = udp                             ; transport for the outbound PUBLISH R-URI: udp (default),
;                                                    ; tcp, tls, ws or wss. A bare sip:<exten>@<host>:<port>
;                                                    ; R-URI makes sofia-sip default to UDP, so a tls/tcp ESC
;                                                    ; was reached over UDP — set this to the ESC's transport.
;                                                    ; Appended as ;transport= to the R-URI; udp/empty is a
;                                                    ; no-op (existing configs unchanged). Invalid -> udp + warn.
;
; Then opt a peer in (in its [peer] section): publish = yes
; Optionally override WHAT that peer publishes with publish_exten (per-peer; ext1[@ctx]&ext2[@ctx]...) —
; useful to publish a different presentity than the dialplan regexten. Each token must have a hint; the
; multi-token "a&b" form is supported (regexten now creates one BLF hint per token, so both BLF and
; PUBLISH cover every token). Empty = use regexten/name.
; Initial sends are jittered and refreshes/state-changes are serialized per presentity, so a 5000-10000
; peer fleet does not thundering-herd the ESC.
;
; KNOWN LIMIT (RFC-compliant, bounded): on a hard stop chan_sofia may not send the Expires:0 unpublish, so
; the ESC clears stale state only when the soft-state TTL lapses (RFC 3903 §3). Worst case = publish_expires
; of staleness after the PBX disappears; for live wallboards set a lower publish_expires.

;
; --- gruu (RFC 5626 instance advertisement on outbound REGISTER — per-peer) ---
; When this server REGISTERs to an upstream registrar AS A CLIENT (a register => trunk: host set,
; secret set, not host=dynamic), `gruu=yes` adds a stable +sip.instance="<urn:uuid:...>" parameter to
; the outbound REGISTER Contact (RFC 5626 §4.1). The URN is derived from this server's EID + the peer
; name, so it is unique per peer and stable across restarts. This lets a GRUU-capable registrar or a
; federation layer uniquely identify this UA instance — useful because chan_sofia registers its Contacts
; under a wildcard user, so the instance is the only stable discriminator.
;
; It also advertises Supported: gruu (RFC 5627 4.1, merged with the stack default timer,100rel) so the
; registrar mints a GRUU. When a GRUU-capable registrar returns a pub-gruu (and rotating temp-gruu) for
; our instance in the REGISTER 200 OK Contact (RFC 5627 5.2), chan_sofia learns + stores them (shown in
; `sip show peer` as Pub-GRUU / Temp-GRUU); they are opaque and cleared when the registration goes
; inactive. With use_gruu_contact=yes (the default), chan_sofia then USES that learned pub-gruu as the
; Contact of outbound calls + re-INVITEs through this peer (RFC 5627 4.4), so the far end can route
; in-dialog/target-refresh requests back to THIS instance via the registrar; call requests + responses
; on the peer also advertise Supported: gruu. NOT enabled: reg-id / the RFC 5626 outbound flow,
; validation/keepalive OPTIONS. Default off; opt-in per peer.
;
; use_gruu_contact = yes  (default) — interop kill-switch: set no to keep advertising/learning the GRUU
;   but NOT use it as the dialog Contact (falls back to sip:user@our-ip). Only meaningful with gruu=yes.
;
;   [mytrunk]
;   type=peer
;   host=registrar.example.com
;   defaultuser=...
;   secret=...
;   gruu=yes
;   use_gruu_contact=yes

;
; --- service_route (RFC 3608 Service-Route — per-peer, outbound REGISTER trunks) ---
; When this server registers to an upstream registrar (a register=> trunk) that returns a Service-Route
; header in the REGISTER 200, `service_route=yes` ingests it and pre-loads it as a Route on outbound
; INVITEs through that peer, so calls traverse the registrar's service proxy chain (Kamailio/IMS-style
; deployments). The learned route is shown in `sip show peer` and cleared when the registrar stops
; returning it or on de-registration. Default off (opt-in: applying a Service-Route diverts outbound
; routing; only enable it when you know your upstream uses Service-Route). v1 applies it to outbound
; INVITEs only (the registrar's domain); PUBLISH/SUBSCRIBE are a documented follow-on.
;
;   [mytrunk]
;   type=peer
;   host=registrar.example.com
;   secret=...
;   service_route=yes

;
; --- path (RFC 3327 Path — per-peer, dynamic peers behind an edge proxy/SBC) ---
; When a dynamic peer registers THROUGH an edge proxy/SBC that inserts a Path header, path=yes makes
; this server (as the registrar) accept + store that Path with the contact and pre-load it as a Route on
; requests it sends TO that device (INVITEs incl. forked multi-contact), so they traverse the edge proxy
; back to the NATed device (RFC 3327 §5.4). The Path is echoed in the REGISTER 200; if a Path is present
; but the device did NOT advertise Supported: path, the REGISTER is rejected 420 Bad Extension (RFC 3327
; §5.3 — an intermediary inserted Path without UA support). Default off (opt-in: accepting Path is a
; trust decision, RFC 3327 §7). v1 applies it to outbound INVITEs; NOTIFY/OPTIONS/MESSAGE are a
; documented follow-on (NAT-proxy/Route interaction).
;
;   [myphone]
;   type=friend
;   host=dynamic
;   secret=...
;   path=yes

;
; --- rel100 (RFC 3262 reliable provisional responses / PRACK — per-peer) ---
; When rel100=yes, NON-183 provisional responses we send to this peer (180 Ringing, etc.) are sent
; RELIABLY: chan_sofia adds Require: 100rel + an RSeq and waits for the caller's PRACK (sofia-sip's
; native reliable-response machinery handles the PRACK transaction). Useful for carriers/gateways that
; track ringing reliably. NOTE: the 183 Session Progress early-media response is ALREADY sent reliably
; whenever the caller advertises Supported: 100rel — this knob only adds reliability to the OTHER
; provisionals. Default off (opt-in: a few UACs advertise 100rel but mishandle a reliable 180; a PRACK
; timeout then fails the INVITE). The outbound/UAC side (we PRACK a reliable provisional a far end sends
; us) already works without configuration.
;
;   [mygateway]
;   type=peer
;   host=gw.example.com
;   rel100=yes

;
; --- sip_outbound (RFC 5626 SIP Outbound — per-peer, on register=> trunks) ---
; When this peer registers OUTBOUND to an upstream registrar (a `register =>` trunk: non-dynamic host +
; secret AND an explicit [general] register=> line — secret+static-host alone does NOT register), sip_outbound=yes
; makes the REGISTER advertise "Supported: outbound, path" and carry a stable "+sip.instance" (a UUID URN
; derived from the server EID + peer name, persistent across restarts) plus "reg-id=1" on the Contact —
; so a SIP-Outbound-capable registrar/edge proxy keeps the client-initiated flow and routes inbound calls
; back over it (RFC 5626 §4.2.1). This uses manual signalling, NOT the sofia-sip outbound engine (no
; STUN/OPTIONS probing). The keep-alive that holds the flow open is the connection-oriented CRLF ping —
; configure tcp_keepalive (and tcp_pingpong) for TCP/TLS trunks; a warning is logged if the registrar
; confirms outbound (Require: outbound in the 200) but no keep-alive is set or it is slower than the
; registrar's Flow-Timer. The runtime state (confirmed + Flow-Timer) is shown in `sip show peer`. Shares
; the +sip.instance with gruu=yes; default off (opt-in). UDP STUN keep-alive and multi-flow are a
; documented follow-on.
;
;   [mytrunk]
;   type=peer
;   host=sip.example.com
;   defaultuser=...
;   secret=...
;   sip_outbound=yes
;   tcp_keepalive=30   ; if the trunk is TCP/TLS

;
; --- regexten + regextenonqualify (chan_sip parity, drop-in registration-coupled dialplan) ---
; Auto-add a dialplan extension when a peer registers; auto-remove when the peer
; unregisters or (optionally) when qualify reports the peer unreachable. Common
; uses: presence-monitor hint extensions tied to peer registration state, dialplan
; dispatch lines that should only exist while the peer is online.
;
; regcontext = MASTER SWITCH. Names the dialplan context that holds auto-added
;   extensions. EMPTY (default) DISABLES THE ENTIRE MECHANISM — without regcontext
;   set, per-peer regexten= is parsed and stored but never affects the dialplan.
;   chan_sip parity at chan_sip.c:5198-5199 (register_peer_exten outer gate).
;
; regextenonqualify = couple regexten add/remove to qualify state transitions.
;   When yes, the extension is also removed when qualify marks the peer
;   UNREACHABLE and re-added when REACHABLE — operators presence-monitor reachability
;   via dialplan hints. Default no per chan_sip sip.h:215 DEFAULT_REGEXTENONQUALIFY.
;
; Per-peer regexten= override (in [peer] section) accepts:
;   - Single extension: regexten=200            -> '200' added in regcontext
;   - Multi-extension via &: regexten=200&201   -> '200' AND '201' added
;   - Per-ext context override: regexten=200@hints&201@otherctx
;   - Empty per-peer regexten with regcontext set: peer->name used as fallback extension
;     (e.g., regcontext=hints + peer alice with no regexten= -> 'alice' added in [hints])
;
; chan_sofia extension over chan_sip: AMI RegextenOnQualifyTransition event fires on
; every add/remove (Peer + Extension + Context + Direction:add|remove) so NMS systems
; can monitor regexten dialplan-mutation in real time. chan_sip silently fires
; register_peer_exten with no AMI signal.
;
; KNOWN LIMITATION (chan_sofia divergence): chan_sip's cleanup_stale_contexts on
; reload (when regcontext value changes) is NOT implemented — chan_sofia is
; non-unloadable (sofia-sip same-thread-as-create assert), so operators
; restart gabpbx for regcontext value changes. Stale extensions from the prior
; regcontext value remain until restart. Operators changing regcontext rarely
; (typically once at deploy time) are unaffected.
;
;regcontext        = hints      ; dialplan context for auto-added register extensions
;regextenonqualify = no         ; couple regexten add/remove to qualify state transitions

;
; --- subscribecontext (chan_sip parity, drop-in PARSE-COMPAT today; effect-pending) ---
; In chan_sip, subscribecontext routes inbound SIP SUBSCRIBE method dispatches
; to a SEPARATE dialplan context (instead of the peer's voice-call context).
; Operators isolate presence/MWI signaling-state-only logic from voice dialplan.
;
; Per-peer subscribecontext= overrides default_subscribecontext from [general].
; chan_sip operator scripts copying these config keys copy verbatim to chan_sofia.
;
; EFFECT (presence/BLF, active): chan_sofia now serves inbound presence/BLF
; subscriptions (Event: dialog / dialog-info / presence) — it registers a hint
; watcher with the dialplan and pushes dialog-info+xml / pidf+xml / xpidf+xml
; NOTIFYs as the watched extension's state changes (so `core show hints` counts
; the watcher and BLF lamps track). subscribecontext selects the dialplan context
; whose hints a watcher may subscribe to: a presence SUBSCRIBE for extension N
; resolves the hint as N@<subscribecontext> (falling back to the peer's voice
; context, then "default"). Use it to isolate which hints a peer can watch.
; Subscriptions are gated by allowsubscribe (above). Event: message-summary still
; routes to the MWI handler; unknown event packages are auto-202'd.
;subscribecontext = presence    ; in [general]: the default all peers inherit (the [general] key IS
;                               ; `subscribecontext` — there is no `default_subscribecontext` key)
;subscribecontext = presence    ; in a [peer] section: per-peer override

;
; --- SIP instant messaging (SIMPLE, out-of-dialog MESSAGE) ---
; NATIVE PEER-TO-PEER RELAY (default ON): an authenticated sender's out-of-dialog MESSAGE
; whose To-user resolves — through the SENDER's own subscribecontext hint namespace
; (exten -> SIP/<peer>, the same auto-created BLF/regexten hints, tenant-scoped) — to a
; registered local peer is re-originated to that peer's live contact(s) (all of them),
; answering 202. If the extension resolves but the peer has no live contact: 480. This
; needs no dialplan. Disable with message_autorelay=no to keep only the message_context
; path below. The sender is identified/challenged by its digest Authorization username.
;message_autorelay = yes                 ; [general] native peer-to-peer MESSAGE relay (default yes)
;
; NAT traversal (chan_sip-compatible). May be set in [general] (inherited by every peer that has
; no nat= line of its own — an empty realtime nat column inherits too) and overridden per peer.
;   nat = no                    ; no NAT handling
;   nat = force_rport           ; (default) honor/force Via rport for SIP RESPONSE ROUTING only
;                               ; (RFC 3581). Does NOT affect where RTP media is sent.
;   nat = comedia               ; symmetric RTP: send media to the peer's real packet source
;                               ; (learned address) instead of the SDP c= address. Use for
;                               ; NAT'd endpoints whose SDP leaks a private address.
;   nat = force_rport,comedia   ; both (same as nat=yes)
; IMPORTANT: only comedia moves media. A trunk fronted by a signaling-only proxy (e.g. a
; Kamailio without an RTP relay) must NOT have comedia, or media would be sent to the proxy
; address instead of the SDP endpoint; with the default force_rport, RTP follows the SDP.
;nat = force_rport
;
; OPT-IN dialplan path (used when the relay is off, or the To-user is not a local hinted
; peer): when message_context is set, an out-of-dialog SIP MESSAGE is routed to that
; dialplan context (exten = the To-user). With neither a per-peer nor a [general]
; message_context, an out-of-dialog MESSAGE is answered 405 (messaging off). An in-call
; MESSAGE always reaches the channel as a TEXT frame regardless of this setting.
; The launched dialplan extension can read these channel variables:
;   SIPMESSAGE_FROM, SIPMESSAGE_FROM_DISPLAY, SIPMESSAGE_TO, SIPMESSAGE_RURI,
;   SIPMESSAGE_PEER (matched local peer, empty if guest), SIPMESSAGE_CONTENT_TYPE,
;   SIPMESSAGE_BODY (the message text).
; Unknown senders are accepted only when allowguest=yes; otherwise 403.
;message_context = sipmessages          ; [general] default context for inbound MESSAGE
;message_context = sipmessages          ; per-peer override (in [peer] section)
;
; Send a SIP MESSAGE OUT of dialog from the dialplan or AMI:
;   dialplan: SofiaSendMessage(<peer-or-uri>,<body>[,<from>])
;   AMI:      Action: SofiaMessageSend / To: <peer-or-uri> / From: <uri> / Body: <text>
; <peer-or-uri> is a configured peer name or a sip:/sips: URI.

;
; --- Registration TTL bounds + 423 Interval Too Brief (chan_sip parity, RFC 3261 §10.2.8) ---
; Govern peer-requested REGISTER expires interval. Prevents (a) resource exhaustion
; from peers re-registering aggressively at very short TTLs, (b) over-stale
; registrations that delay dead-peer detection at very long TTLs.
;
; Semantics (chan_sip parity at chan_sip.c:25699-25702):
;   - peer-requested expires > maxexpiry: silently capped to maxexpiry; 200 OK accepts
;   - peer-requested expires < minexpiry (and > 0): rejected with 423 Interval Too Brief
;     + Min-Expires:<minexpiry> header (RFC 3261 §10.2.8); peer retries with valid value
;   - peer-requested expires == 0: bypasses bounds (unregister) — standard processing
;   - defaultexpiry: fallback when peer omits Expires header from REGISTER + initial
;     value for peer->expiresecs at sofia_peer_alloc when peer config omits expiresecs=
;
; chan_sip historical TYPO-TOLERANCE (drop-in compat preserved): chan_sip parser
; accepts BOTH spellings of each key — chan_sofia mirrors. Operators with historical
; typo'd configs (minexpirey/maxexpirey/defaultexpirey extra-e form) reload cleanly.
;
; chan_sofia extension over chan_sip silent reject: AMI RegisterIntervalRejected event
; fires on every 423 reject (Peer + RequestedExpires + MinExpires + ResponseCode +
; Reason: BelowMinExpiry) so NMS systems gain real-time signal for REGISTER-storm
; or aggressive-re-register pattern monitoring. chan_sip emits no AMI signal (only
; LOG_NOTICE).
;
; KNOWN DIVERGENCE (dual-scope): chan_sip uses defaultexpiry as
; [general]-only key. chan_sofia historically also accepts defaultexpiry as a
; PER-PEER alias for expiresecs= (legacy chan_sofia operators). Both scopes are
; supported today: [general] defaultexpiry sets sofia_cfg.default_expiry (chan_sip
; parity); per-peer expiresecs= or defaultexpiry= overrides per-peer (chan_sofia
; legacy). Operators with chan_sip [general] defaultexpiry configs migrate verbatim;
; chan_sofia operators using per-peer alias see no behavior change.
;
minexpiry      = 90        ; minimum REGISTER expires (seconds); under-min rejected with 423 Min-Expires:90
maxexpiry      = 3600      ; maximum REGISTER expires (seconds); over-max silently capped
;defaultexpiry  = 120      ; fallback expires when peer omits Expires header; also peer->expiresecs default
;
; Typo-tolerance variants accepted (chan_sip parity): minexpirey / maxexpirey / defaultexpirey

;
; --- usereqphone (chan_sip parity, RFC 3966 telephone-uri) ---
; Append ;user=phone parameter to outbound Request-URI + From URI when peer's
; user-part matches digit-only pattern (with optional leading +). Required by
; PSTN gateways that expect RFC 3966 telephone-uri formatting for E.164 numbers.
;
; Mechanism (chan_sip parity at chan_sip.c:12836-12853 + L28781-L28782 + L29660-L29661):
;   - peer username "15555551212" + usereqphone=yes → URI "sip:15555551212@host;user=phone"
;   - peer username "+15555551212" + usereqphone=yes → URI "sip:+15555551212@host;user=phone"
;   - peer username "alice" (alphanumeric) + usereqphone=yes → URI "sip:alice@host" (no parameter; pattern fails)
;   - peer username "15555551212" + usereqphone=no → URI "sip:15555551212@host" (default; opt-in)
;
; Per-peer usereqphone= overrides [general] default. chan_sip operator scripts copy verbatim.
;
; chan_sofia uses a single-helper internal extension —
; sofia_resolve_peer_target (Request-URI builder) + sofia_build_from (From-URI builder)
; each have one extension site that catches all callsites (sofia_request_call INVITE +
; sofia_process_refer transfer + sofia_qualify_peer + sofia_call SDP/no-SDP +
; fork-children). chan_sip duplicates the digit-pattern check at each per-message
; URI-build site.
;
; chan_sofia extension: 3-state CLI inheritance display ('User=Phone: yes (from [general])'
; when peer inherits default; raw 'yes'/'no' when peer-set explicitly).
;
;usereqphone = no    ; in [general]: the default all peers inherit (the [general] key IS `usereqphone`
;                    ; — there is no `default_usereqphone` key)
;usereqphone = no    ; in a [peer] section: per-peer override

;
; --- maxforwards (chan_sip parity, RFC 3261 §20.22 Max-Forwards) ---
; Initial value of Max-Forwards header on outbound INVITE/REGISTER. Decremented
; by each proxy hop; reaching 0 returns 483 Too Many Hops (loop-detection).
; Operators with stateful proxy chains may lower from default 70 to 20-30.
;
; chan_sip parity at chan_sip.c:30011-30015 ([general]) + L28878-28883 (per-peer);
; default DEFAULT_MAX_FORWARDS=70 (sip.h:60 verbatim, RFC 3261 §20.22). 1-255 bounds
; enforced; invalid values clamp to default with LOG_WARNING.
;
; chan_sofia extension: 3-state CLI inheritance display in sip show peer
; ('Max forwards: <value> (from [general])' when peer inherits default; raw value
; when peer-set explicitly).
;
; Emitted via sofia-sip native SIPTAG_MAX_FORWARDS_STR at all outbound nua_invite +
; nua_register callsites (8 sites total).
;
;maxforwards = 70    ; [general] default OR per-peer override (1-255 valid range)

;
; --- t1min (chan_sip parity, RFC 3261 §17.1.1.2 T1 retry-timer minimum) ---
; Minimum SIP transaction retry-timer T1 in milliseconds. Default 100ms per
; chan_sip parity (sip.h:217 DEFAULT_T1MIN). RFC 3261 §17.1.1.2 default is 500ms;
; chan_sip overrides to lower 100ms minimum bound. sofia-sip honors via NTATAG_SIP_T1
; at nua_create — global NTA-layer setting; all transactions inherit.
;
; Operationally: lower t1min means faster retransmission detection on healthy networks
; (better UX); higher t1min reduces retransmission storms on high-latency networks.
;
; KNOWN LIMITATION: per-peer dynamic T1 = max(peer->lastms, t1min) chan_sip parity
; (chan_sip.c:6024+L17056) DEFERRED — requires per-handle nua_set_hparams
; override at outbound nua_invite per dialog; complex per-peer state-tracking via
; qualify-RTT. Not currently implemented.
;
;t1min = 100    ; minimum T1 retry-timer in milliseconds (chan_sofia minimum 10ms)

;
; --- relaxdtmf + prematuremedia (chan_sip parity, [general] media-layer flags) ---
;
; relaxdtmf — toggle DSP_DIGITMODE_RELAXDTMF flag in ast_dsp digit detection.
;   When yes, ast_dsp uses relaxed threshold for DTMF tone detection — helps detect
;   DTMF on poor-quality lines (high jitter / packet loss / low-volume tones) at the
;   cost of more false positives (audio frequencies near DTMF being mis-detected as
;   keypresses). Default no per chan_sip parity at chan_sip.c:29518. Only effective
;   when peer dtmfmode=inband (chan_sofia DSP allocated by sofia_enable_dsp_detect
;   only for inband DTMF mode).
;
; prematuremedia — IMPORTANT: INVERTED-SEMANTIC chan_sip-quirk preserved per drop-in
;   compat. Internal variable name `prematuremediafilter` reveals the actual semantic:
;     - prematuremedia=yes (DEFAULT) → filter ON → 183 Session Progress SUPPRESSED
;       even on explicit dialplan Progress() call. Early-media frames blocked.
;     - prematuremedia=no → filter OFF → 183 emitted on Progress(); early-media flows.
;   Operator-confusing-but-chan_sip-faithful: yes reads as "allow" but actually MEANS
;   "filter/suppress". chan_sip.c:7298 + L29458 verbatim parity (default TRUE = filter
;   ON). chan_sip operator scripts copying prematuremedia= work identically here.
;
;relaxdtmf       = no    ; default; yes = relaxed DTMF detection (poor-quality lines)
;prematuremedia  = yes   ; default; yes = SUPPRESS 183 (filter ON); no = ALLOW 183 (filter OFF)

;
; --- registertimeout + registerattempts (chan_sip parity, outbound REGISTER retry control) ---
; Application-level scheduled-retry control for outbound REGISTER (when chan_sofia
; operates as UAC registering to upstream registrars via register=> directive).
;
; registertimeout — seconds between retry passes (sofia_reg_thread sleep interval).
;   chan_sip parity at chan_sip.c:14217 + L29799-29803. Default 20s per
;   sip.h:59 DEFAULT_REGISTRATION_TIMEOUT verbatim. atoi + clamp-to-default if <1.
;
; registerattempts — maximum scheduled-retry count per peer (0 = unlimited).
;   chan_sip parity at chan_sip.c:14092 + L29804-29805. Default 0 (unlimited)
;   per chan_sip global_regattempts_max static-zero init. When set, registration
;   gives up after N failed attempts (auth-challenge or scheduled re-register).
;
; SEMANTIC NOTE: These are APPLICATION-LEVEL retry-policy flags, NOT sofia-sip
; per-transaction retry (NUTAG_RETRY_COUNT) which operates at a different
; semantic layer (transaction-internal retry on 5xx/ICMP-unreachable within a
; single attempt). chan_sip operator-facing semantic preserved verbatim.
;
;registertimeout  = 20    ; seconds between retry attempts; default 20s
;registerattempts = 0     ; maximum retries; 0 = unlimited (default; chan_sip parity)

;
; --- directrtpsetup (chan_sip parity, EXPERIMENTAL — PARSE-COMPAT-ONLY) ---
; chan_sip experimental feature (default DISABLED per chan_sip.c:29449
; verbatim "Experimental feature, disabled by default"). When enabled in
; chan_sip, allows early RTP bridge before call answers — operationally niche.
;
; KNOWN LIMITATION: chan_sofia
; parse-compatibility only — field is parsed + stored + reload-clean for
; operators with chan_sip configs containing directrtpsetup=, but the
; full-feature early-RTP-bridge implementation is DEFERRED. Reasoning: chan_sip
; itself defaults the feature DISABLED and labels it experimental; no current
; operator need for full-feature ship. Not currently implemented. Drop-in
; PARSE-COMPAT primary value preserved (chan_sip operator
; scripts containing directrtpsetup=no — default — reload cleanly).
;
;directrtpsetup = no    ; default; experimental — PARSE-COMPAT-ONLY today (effect-deferred)

;
; --- alwaysauthreject (chan_sip parity, security-critical) ---
; When yes (default), REGISTER from an unknown peer + MWI SUBSCRIBE for an
; unknown mailbox both return 401 Unauthorized with a bogus digest challenge
; instead of 403/404. RFC 3261 §22.4 username-enumeration prevention: an
; attacker probing for valid SIP accounts cannot distinguish "peer exists with
; bad password" from "peer does not exist". Default is yes per chan_sip
; sip.h:213 DEFAULT_ALWAYSAUTHREJECT=TRUE — drop-in security baseline; chan_sip
; operator scripts containing alwaysauthreject=yes/no migrate verbatim.
; chan_sofia extension: every triggered 401 also emits an AMI AuthFailure event
; (Peer:UNKNOWN + Method + Reason + RemoteAddr) so an NMS can detect
; brute-force probing in real time (chan_sip is silent on the same paths —
; operators must grep authpedantic LOG_NOTICE). Note: GabPBX has no
; EVENT_FLAG_SECURITY class, so the event ships under EVENT_FLAG_SYSTEM
; matching existing chan_sofia AMI events; subscribe via system permission.
; chan_sip parity: chan_sip.c:29699-29700 ([general] parser) + sip.h:213.
;
;alwaysauthreject = yes    ; default; RFC 3261 §22.4 username-enumeration prevention

;
; --- compactheaders (chan_sip parity, PARSE-COMPAT-ONLY) ---
; chan_sip emits short-form SIP header aliases (m=Contact, t=To, f=From, etc.)
; via find_alias per-header translation at message-build time (chan_sip.c:10716)
; when this flag is yes. Default off per sip.h:194 DEFAULT_COMPACTHEADERS=FALSE.
;
; KNOWN LIMITATION: chan_sofia
; parse-compatibility only — value is parsed + stored + reload-clean for operators
; with chan_sip configs containing compactheaders=, but the full-feature
; compact-emit implementation is DEFERRED. ROOT CAUSE: sofia-sip ZERO native compact-emit
; gate (verified across nta_tag.h + nua_tag.h + sip_tag.h — no NUTAG_USE_COMPACT
; / SIPTAG_COMPACT / use_compact). chan_sofia delegates message-build to
; sofia-sip layer below the per-header-alias-rewrite point; no interception
; available without invasive sofia-sip patch.
;
; The root cause is a sofia-sip library feature absence. Future-fix path: upstream sofia-sip
; exposes NUTAG_USE_COMPACT or equivalent → chan_sofia adds the implementation at
; nua_create / per-message tag list. Until then, chan_sofia outbound messages
; emit long-form SIP headers regardless of compactheaders setting.
;
;compactheaders = no    ; default; PARSE-COMPAT-ONLY today (effect-deferred per sofia-sip-library-absence)

;
; --- disallowed_methods (chan_sip parity, PARSE-COMPAT-ONLY) ---
; Comma-separated list of SIP method names blocked from outbound Allow header.
; Operators block unwanted methods (e.g. PUBLISH, MESSAGE, OPTIONS) that should
; never be accepted from upstream peers. Both [general] and per-peer scope
; supported (per-peer overrides [general]).
;
; KNOWN LIMITATION: chan_sofia
; parse-compatibility only — value is parsed + stored as STRING and reload-clean
; for operators with chan_sip configs containing disallowed_methods=, but the
; full-feature dynamic NUTAG_ALLOW generation per-handle is DEFERRED. Reasoning:
; chan_sofia uses hardcoded NUTAG_ALLOW string at nua_create which is already
; restrictive (only INVITE/ACK/BYE/CANCEL/OPTIONS/REGISTER/SUBSCRIBE/NOTIFY/
; REFER/MESSAGE/INFO/PUBLISH/PRACK); per-handle dynamic Allow rebuild is ~80-150
; LoC complex per-dialog implementation with no current operator need. Not
; currently implemented. STRING-STORAGE SHORTCUT avoids porting
; mark_parsed_methods + SIP_METHOD_* constants from chan_sip.
;
; chan_sip default is SIP_UNKNOWN bitmask (default DISALLOWS unknown methods);
; chan_sofia default empty string (divergence — sofia-sip
; NUTAG_APPL_METHOD handles unknown-method gating natively at NUA layer).
;
;disallowed_methods = PUBLISH,MESSAGE    ; PARSE-COMPAT-ONLY today; effect-deferred

;
; --- contactpermit + contactdeny (chan_sip parity, security ACL) ---
; SEPARATE ACL chain applied to peer Contact-header URL host at REGISTER
; processing. Distinct from per-peer permit/deny (source-IP ACL):
; operator can have peer registering FROM allowed source-IP but with disallowed
; Contact-IP — hardening against forwarding-via-attacker pattern (peer
; registers Contact: sip:user@attacker.example pointing the registrar at an
; attacker-controlled host).
;
; chan_sip parity at chan_sip.c:28827-28832 (per-peer parser) + L29646-29648
; ([general] parser) + L15043-15044 (apply at REGISTER processing). Verbatim
; ast_append_ha + ast_apply_ha API.
;
; Both per-peer and [general] scope supported (per-peer overrides [general] is
; INCORRECT — chan_sip parity = BOTH apply via short-circuit OR; either DENY rejects).
; Operator scripts copying chan_sip contactpermit/contactdeny migrate verbatim.
;
; KNOWN LIMITATION:
; directmediapermit/directmediadeny per-peer DEFERRED — chan_sip semantic is
; cross-peer cross-leg (peer A's directmediaha gates peer B's RTP remote-addr
; at SDP-processing-time per-medium; chan_sip.c:30362+L30414+L30503+L30561+L30610).
; chan_sofia full-feature implementation requires SDP-time bridge-partner access at
; sofia_process_invite/reinvite — separate task. parse-compatibility only for
; directmedia ACL keys NOT included this commit (avoids semantic-inverted
; placeholder). Not currently implemented.
;
;contactpermit = 1.2.3.0/24    ; per-peer OR [general]; multi-rule via multiple lines
;contactdeny   = 0.0.0.0/0     ; default-deny then permit specifics

;
; --- directmediapermit + directmediadeny (chan_sip parity, cross-peer ACL) ---
; CROSS-PEER CROSS-LEG ACL applied at direct-media decision point: when this
; peer is the BRIDGE PARTNER, refuse direct-media if the OTHER leg's remote
; endpoint is in deny range. chan_sip parity at chan_sip.c:30362-30385
; apply_directmedia_ha verbatim semantic. Per-peer-only (chan_sip [general] ABSENT).
;
; Operator semantic: "peer X has directmediadeny=10.0.0.0/8" means: when X is
; the bridge partner, chan_sofia refuses to bypass itself with direct-media
; if the OTHER leg's remote endpoint is in 10.0.0.0/8 — RTP forced through PBX.
; Use case: peer X is internal trunk; deny direct-media to internal endpoints
; (force PBX to inspect/log/transcode); allow direct-media to public endpoints.
;
; chan_sofia extension — single
; sofia_get_rtp_peer gate covers all media (audio/video/text/T.38). chan_sip
; applies at 4 process_sdp callouts L30414+L30503+L30561+L30610 per-medium
; duplication; chan_sofia centralized helper catches all callsites at once.
;
; Previously deferred from the contactpermit/contactdeny work and implemented here.
;
;directmediapermit = 192.168.0.0/16    ; per-peer; multi-rule via multiple lines
;directmediadeny   = 0.0.0.0/0         ; default-deny then permit specifics

;
; --- dnsmgr async DNS hostname-tracking (chan_sip parity) ---
; When peer host=hostname (not IP literal), chan_sofia automatically registers an
; async DNS-tracking handle that re-resolves the hostname on a periodic refresh
; schedule. peer->src_addr stays current with upstream gateway DNS changes
; (DDNS hostnames, multi-A-record, failover scenarios). chan_sip parity at
; chan_sip.c:29137-29161 + L13292 callback + L3419-3422 cleanup verbatim.
;
; SYSTEM-WIDE ENABLE: dnsmgr is controlled by res_dnsmgr.so module (dnsmgr.conf).
; chan_sofia has NO per-channel-driver enable key — relies on system-wide dnsmgr
; setting. When dnsmgr is disabled in dnsmgr.conf, chan_sofia peer->dnsmgr stays
; NULL (no refresh handle allocated; behavior identical to pre-this-task).
;
; AUTO-DETECT: peer host=IP-literal (e.g. host=1.2.3.4) → no DNS lookup needed;
; chan_sofia ast_sockaddr_parse pre-check skips dnsmgr registration. peer
; host=hostname (e.g. host=trunk.example.com) → ast_dnsmgr_lookup_cb registers
; refresh handle if dnsmgr enabled.
;
; chan_sofia extension over chan_sip silent: AMI DnsManagerUpdate event fires on
; every DNS change (Peer:SIP/<name> + OldAddr + NewAddr) for NMS visibility into
; upstream gateway IP changes. chan_sip emits no AMI signal at on_dns_update_peer.
;
; sip show peer "DNS-managed: yes/no" line indicates whether peer has a refresh
; handle active (yes = system-wide dnsmgr enabled AND host is hostname AND lookup
; succeeded; no otherwise).
;
; To enable: configure res_dnsmgr.so via dnsmgr.conf [general] enable=yes +
; refreshinterval=300 (or operator-tuned). Affects ALL gabpbx channel drivers
; that use ast_dnsmgr_* APIs (chan_sip + chan_sofia + others).

;
; --- Dynamic presence hints (dynamic hints chan_sip parity) ---
; When a peer has BOTH regexten= AND subscribecontext= configured, chan_sofia
; auto-creates a PRIORITY_HINT extension at peer-load time. The hint extension
; tracks peer presence via DEVICE_STATE(SIP/<peer-name>) so dialplan / SUBSCRIBE
; clients can monitor reachability without manual hint configuration.
;
; Mechanism (mirrors the dynamic hints patch at chan_sip.c:5599-5606):
;   - Realtime peers: hint created at sofia_find_peer_realtime conclusion
;     (registrar = "realtime_peer" — chan_sip parity).
;   - Config-file peers (chan_sofia extension — chan_sip fires realtime-only):
;     hint created at sofia_parse_peer_config conclusion (registrar =
;     "sofia_config_peer" — operator visibility into hint origin via
;     `core show hints` Replace column).
;   - Hint device string: "SIP/<peer->name>" matches chan_sofia AMI events +
;     Dial(SIP/<peer-name>) operator-facing convention. (chan_sip uses
;     peer->username = SIP auth identity; chan_sofia uses peer->name for
;     consistent operator-facing semantic.)
;
; chan_sofia extension: AMI HintCreated event fires on every hint installation
; (Peer + Extension + Context + HintDevice + Source:realtime|config). chan_sip
; emits no AMI signal at hint creation. NMS systems gain real-time visibility
; into hint lifecycle.
;
; HINT REMOVAL: each per-token hint IS removed (symmetric with creation) when the peer drops regexten/
; subscribecontext or disappears on `sip reload` (re-parse + sweep) and on realtime prune/unregister.
; The only uncovered case is module UNLOAD — chan_sofia is non-unloadable (sofia-sip
; same-thread-as-create assert), so there is no unload-time cleanup; that path never runs in practice.
;
; To use: configure both regexten + subscribecontext on the peer (in [peer]
; section or sippeers realtime row); hints auto-install at peer load.
; Example:
;   [alice]
;   regexten=200
;   subscribecontext=hints
;   ; → at peer load: extension '200' added in [hints] context as PRIORITY_HINT
;   ;   pointing at SIP/alice; presence visible via DEVICE_STATE(SIP/alice).

;
; --- MOH per-peer (mohinterpret/mohsuggest parity) ---
; Default MOH classes for peers without explicit mohinterpret/mohsuggest config.
; mohinterpret = MOH class to play when remote peer puts us on hold
;                (ast_moh_start third-arg fallback when peer's mohsuggest absent).
; mohsuggest   = MOH class to suggest to bridged channel when this peer puts us
;                on hold (INBOUND propagation via AST_CONTROL_HOLD data).
;                NOTE: chan_sofia does NOT issue outbound HOLD re-INVITE today,
;                so OUTBOUND-direction Alert-Info mohsuggest signaling is NOT
;                supported (deferred to outbound-HOLD-re-INVITE feature task).
;default_mohinterpret = default
;default_mohsuggest   = default

;
; --- language (chan_sip parity, drop-in per-peer audio locale) ---
; Default audio language locale propagated to ast_channel.language for prompts/
; sounds (e.g. en, es, fr, de). Empty default = use gabpbx-core default. Per-peer
; language= overrides this. chan_sip parity chan_sip.c:29709-29710 [general] +
; chan_sip.c:28865-28866 per-peer + chan_sip.c:28447 inheritance. Bounded to
; channel.h:138 MAX_LANGUAGE=40.
;
;language = es

;
; --- parkinglot (chan_sip parity, drop-in Park()/transfer routing) ---
; Default parking-lot routing field propagated to ast_channel.parkinglot at
; sofia_new for Park()/transfer-to-park dialplan operations. Per-peer parkinglot=
; overrides this. Default "default" per chan_sip features.h:37
; DEFAULT_PARKINGLOT — chan_sip drop-in.
;
; KNOWN BEHAVIOR CHANGE: prior chan_sofia baseline emitted
; NO parkinglot on channels (silent-empty default); this task ships chan_sip-
; verbatim "default" string default, so every channel now inherits parkinglot=
; "default" by default. Operators preferring the prior silent-baseline
; restoration set [general] parkinglot= empty explicitly (peers can also
; override via per-peer parkinglot=NAME).
;
;parkinglot = default

;
; --- tos/cos bundle 8-key (chan_sip parity, QoS markings) ---
; 8-key bundle for SIP signaling + RTP audio/video/text QoS markings:
;   tos_sip / tos_audio / tos_video / tos_text  ; L3 TOS/DSCP markings
;   cos_sip / cos_audio / cos_video / cos_text  ; L2 802.1p CoS markings
;
; Default 0 for all 8 (no QoS markings). Values accept symbolic (cs3, ef,
; af41, lowdelay) + numeric forms via ast_str2tos / ast_str2cos parsers.
;
; chan_sip parity citations: chan_sip.c:730-737 globals + L29893-29917 8
; [general] parsers + L5888 use site (ast_rtp_instance_set_qos). gabpbx-core
; API at rtp_engine.h:1311.
;
; Implementation matrix:
;   tos_sip               → TPTAG_TOS at nua_create (sofia-sip native)
;   tos_audio + cos_audio → ast_rtp_instance_set_qos on pvt->rtp at sofia_rtp_init
;   tos_video + cos_video → ast_rtp_instance_set_qos on pvt->vrtp (when video)
;   cos_sip               → PARSE-COMPAT-ONLY (sofia-sip TPTAG_COS verified
;                           ABSENT in tport_tag.h grep; full-feature DEFERRED
;                           until upstream surfaces); operators get verbatim
;                           parse-clean migration from chan_sip configs
;   tos_text + cos_text   → PARSE-COMPAT-ONLY (chan_sofia text-RTP infrastructure
;                           ABSENT — no pvt->trtp); future text-RTP implementation
;                           when chan_sofia adds T.140 support
;
; A sofia.conf with tos_sip=cs3 + tos_audio=ef + tos_video=af41 has these
; values honored on reload.
;
; Reload-required note: changing values requires `module reload
; chan_sofia.so` to pick up the new defaults; existing in-flight calls retain
; their original socket-level QoS settings until tear-down.
;
tos_sip = cs3
tos_audio = ef
tos_video = af41
;tos_text = af41
;cos_sip = 3
;cos_audio = 5
;cos_video = 4
;cos_text = 4

;
; --- useragent (chan_sip parity, [general] User-Agent/Server header) ---
; User-Agent header value advertised in outbound SIP requests + Server header
; in responses. Default "GABpbx PBX X.Y.Z" (composed at config-load via
; snprintf "%s %s", DEFAULT_USERAGENT, ast_get_version() — chan_sip parity at
; chan_sip.c:29455 + sip.h:219-220 verbatim shape).
;
; Operator customization use cases:
;   * security-hardening — hide server software identification from scanners
;   * brand/version-string operator-policy — replace with operator-branded UA
;   * carrier-fingerprint matching — emulate specific PBX vendor for
;     interoperability with carriers that whitelist by User-Agent
;
; chan_sip parity citations: chan_sip.c:29455 default-init + L29574-29575
; [general] parser + sip.h:219-220 DEFAULT_USERAGENT macro definition.
;
; KNOWN BEHAVIOR CHANGE: chan_sofia prior to this commit emitted sofia-sip
; library default "sofia-sip/1.13.17" on
; outbound traffic; this ship overrides with chan_sip-verbatim default for
; drop-in faithfulness — operators copying sip.conf [general] useragent= lines
; to sofia.conf get byte-identical User-Agent header in SIP traces / billing
; systems / fingerprinting tools.
;
; Implementation via SIPTAG_USER_AGENT_STR at nua_create (sip_tag.h:2183 macro). sofia-sip
; emits header on every outbound request + response automatically once tag
; set on nua handle
; (single emit-site vs chan_sip 5-site add_header duplication at chan_sip.c
; L11132 response Server + L11307+12986+14331 outbound User-Agent + others).
;
; A sofia.conf with useragent=a carrier softswitch V300R011 has that value
; honored on reload.
;
; Reload-required note: changing useragent= requires
; `module reload chan_sofia.so` to pick up the new value; in-flight nua
; handle is destroyed and re-created at reload, so subsequent outbound
; transactions emit the new User-Agent immediately.
;
;useragent = a carrier softswitch V300R011

;
; --- rtp-timeout bundle (chan_sip parity, RTP stream no-traffic detection) ---
; 3-key bundle for RTP-stream no-traffic detection + dead-call cleanup +
; periodic keepalive emission. Default 0 for all 3 (disabled).
;   rtptimeout      = N    ; drop call after N seconds without inbound RTP
;   rtpholdtimeout  = N    ; same but for on-hold state (typically larger; calls
;                          ; on hold can sit silent indefinitely otherwise)
;   rtpkeepalive    = N    ; send periodic keepalive RTP packet every N seconds
;
; chan_sip parity citations: chan_sip.c:721-723 globals + L28926-28940 per-peer
; parsers + L29668-29680 [general] parsers + L5862-5864 + L5880-5882 use sites
; (ast_rtp_instance_set_timeout / set_hold_timeout / set_keepalive). gabpbx-core
; APIs at rtp_engine.h:1671 + L1689 + L1707.
;
; A sofia.conf with rtptimeout=30 + rtpholdtimeout=300 has these values
; honored on reload.
;
; Reload-required note: changing values requires `module reload
; chan_sofia.so` to pick up the new defaults; existing in-flight calls retain
; their original settings until tear-down.
;
;rtptimeout = 30
;rtpholdtimeout = 300
;rtpkeepalive = 60

;
; --- preferred_codec_only (chan_sip parity, SDP codec-list narrowing) ---
; When yes, outbound SDP m=audio offers/answers contain ONLY the single most-
; preferred codec instead of the full enabled-codec list. Use case: bandwidth-
; constrained scenarios + codec-locked trunks (e.g. opus-only) where operator
; wants to lock outbound SDP to a single codec and refuse fallback negotiation.
; Default no per chan_sip drop-in (full codec list offered).
;
; chan_sip parity citations: chan_sip.c:28922-28923 per-peer parser
; ast_set2_flag SIP_PAGE2_PREFERRED_CODEC + L29863-29864 [general] parser
; global_flags[1] + sip.h:313 flag bit + L10076 use site (process_sdp narrows
; pvt->jointcapability via ast_codec_choose).
;
; chan_sofia extension (chan_sofia-
; strict-direction-symmetric): chan_sip narrows ONLY at process_sdp RESPONSE-
; direction (after computing jointcapability from their offer). chan_sofia
; applies narrowing to BOTH initial-INVITE-offer AND response paths via single
; sofia_generate_sdp helper site — operator semantic preferred_codec_only is
; preserved consistently across both SDP-emit directions (chan_sip slightly
; asymmetric).
;
; Bounded-impact: only when operator explicitly sets the flag (default off).
;
;preferred_codec_only = yes

;
; --- ignoresdpversion (RFC 3264 §8 o= version stickiness; chan_sip process_sdp_o parity) ---
; Governs how chan_sofia treats an inbound re-offer (UPDATE / re-INVITE) that repeats the same
; SDP session origin (the o= line):
;
;   no  (default) — HONOR the o= version. A re-offer with the same origin and an unchanged (<=)
;                   session-version is treated as a no-op: the media/RTP remote is NOT re-applied,
;                   so learned state is preserved. In particular the symmetric-RTP public address
;                   of a NATed peer survives a keepalive re-offer that re-sends the private c=,
;                   which would otherwise blackhole audio (this is the o=-stickiness fix, RFC 3264
;                   §8; mirrors chan_sip's process_sdp_o skip-on-no-change gate).
;   yes           — IGNORE the version and reprocess EVERY inbound SDP unconditionally. Escape
;                   hatch for RFC-violating UAs that change media without bumping the o= version.
;
; Per-peer ignoresdpversion= overrides this [general] default. chan_sip parity:
; SIP_PAGE2_IGNORESDPVERSION (chan_sip.c process_sdp_o). Changing it takes effect on `sip reload`.
;
;ignoresdpversion = yes

;
; --- progressinband (chan_sip parity, tri-state early-media control) ---
; chan_sip semantic: tri-state never/no/yes controlling whether SIP signals
; ringing via 180 Ringing only OR allows in-band audio playback BEFORE 200 OK
; answer. Use case: IVR/announcement playback before answer (e.g. carrier
; "your call cannot be completed as dialed" recordings, custom ringback tones).
;
; Tri-state values:
;   never  (default) - emit 180 Ringing only; never send in-band audio with
;                      provisional response; chan_sofia behavior preserved
;   no               - same effective behavior as never under chan_sofia's
;                      partial implementation (KNOWN LIMITATION below)
;   yes              - emit 180 Ringing + force in-band audio playback (returns
;                      -1 to core which streams audio over RTP per chan_sip
;                      verbatim semantic at chan_sip.c:7631)
;
; chan_sip parity citations: chan_sip.c:28166-28172 verbatim per-peer parser via
; handle_common_options indirection (L29544 [general] call site shares parser
; with L28671 per-peer call site) + sip.h:282-285 verbatim 3 macros (SIP_PROG_
; INBAND (3<<25) + SIP_PROG_INBAND_NEVER (0<<25) + SIP_PROG_INBAND_NO (1<<25)
; + SIP_PROG_INBAND_YES (2<<25)) + chan_sip.c:7616-7637 verbatim use site at
; sip_indicate AST_CONTROL_RINGING + chan_sip.c:19425 verbatim "Progress inband"
; sip show settings display.
;
; KNOWN LIMITATION: NO state degrades to NEVER behavior under chan_sofia
; chan_sofia's partial implementation. chan_sip's NO-state semantic ("after-progress-sent
; in-band 2nd-call behavior") requires SIP_PROGRESS_SENT per-pvt state-tracking
; infrastructure — chan_sofia ABSENT today. Operators wanting full chan_sip
; NO-state semantic must wait for future-fix follow-up (~30 LoC pvt->progress_
; sent state-tracking).
;
; Operator action items:
;   * progressinband=never operators: drop-in compat zero-rewrite (chan_sofia
;     intrinsic baseline matches; current chan_sofia behavior preserved)
;   * progressinband=yes operators: drop-in compat zero-rewrite (chan_sofia
;     the partial implementation returns -1 forcing in-band audio per chan_sip verbatim)
;   * progressinband=no operators: parse-clean migration; effective behavior
;     matches NEVER (KNOWN LIMITATION — full chan_sip NO semantic deferred)
;
; A sofia.conf with `progressinband=no` (the setting intends NEVER-equivalent
; disable-in-band) is honored on reload under chan_sofia's partial
; implementation: NO-state effective behavior = NEVER, which matches operator intent.
;
; Reload-required note: changing progressinband= requires
; `module reload chan_sofia.so` to update parsed value; in-flight calls retain
; their original progressinband state until tear-down.
;
;progressinband = no

;
; --- subscribe_network_change_event (chan_sip parity, parse-compatibility only) ---
; chan_sip semantic: when yes (default), subscribe to gabpbx-core
; AST_EVENT_NETWORK_CHANGE event (event_defs.h:56 AST_EVENT_NETWORK_CHANGE =
; 0x09); on network IP change, re-register all outbound registrations to pick
; up new local IP. Use case: laptop sleep/wake / docking-station IP changes /
; mobile failover where gabpbx-core detects link state change.
;
; chan_sip parity citations: chan_sip.c:30017-30024 verbatim [general] parser
; tri-state (ast_true → 1; ast_false → 0; else LOG_WARNING + skip) +
; chan_sip.c:29314 verbatim default-init = 1 (TRUE; declared as LOCAL var in
; reload_config function scope) + chan_sip.c:30032 verbatim use site
; (network_change_event_subscribe / unsubscribe gating) + chan_sip.c:15507
; ast_event_subscribe(AST_EVENT_NETWORK_CHANGE, ...).
;
; KNOWN LIMITATION: flag has no behavioral effect on chan_sofia. chan_sofia
; delegates network-change handling to sofia-sip native infrastructure:
;   * sofia-sip sres_resolver: transport-layer DNS + IP rebinding handles
;     network IP change automatically without application-level subscription
;   * per-peer dnsmgr: ast_dnsmgr_lookup_cb + sofia_on_dns_update_
;     peer callback updates peer->src_addr on hostname IP change + AMI
;     DnsManagerUpdate emit (chan_sofia extension over chan_sip silent)
;
; chan_sip's manual AST_EVENT_NETWORK_CHANGE subscription is not applicable
; to chan_sofia architecture — sofia-sip + dnsmgr stack absorbs the
; responsibility transparently. This is a design difference, not a gap;
; future-fix path likely never needed.
;
; chan_sofia extension IN-SCOPE: sip show settings displays "Network change
; subscribe: yes/no" at runtime — chan_sip silent at this CLI (chan_sip
; displays only LOG_WARNING at parse-time on invalid value, not the runtime
; value). Additional operator visibility.
;
; Operator action items:
;   * operators with chan_sip [general] subscribe_network_change_event=yes/no
;     migrate verbatim zero-rewrite — parse-clean migration; effective
;     behavior unchanged (chan_sofia delegates to sofia-sip + dnsmgr
;     regardless of flag value)
;   * operators wanting runtime visibility: `sip show settings` displays
;     parsed value (chan_sofia extension)
;
; Reload-required note: changing subscribe_network_change_
; event= requires `module reload chan_sofia.so` to update parsed value (no
; behavioral effect on network-change handling — sofia-sip + dnsmgr continue
; their work regardless).
;
;subscribe_network_change_event = yes

;
; --- rtsavesysname (chan_sip parity, multi-server realtime tracking) ---
; chan_sip semantic: when yes, ast_update_realtime calls at REGISTER paths
; include "regserver" column with ast_config_AST_SYSTEM_NAME (gabpbx instance
; hostname from gabpbx.conf systemname=). Allows multi-server gabpbx
; clusters sharing realtime sippeers/sipregs tables to identify which
; gabpbx instance currently has each peer's registration. Default no
; (regserver column not written).
;
; chan_sip parity citations: chan_sip.c:29590-29591 verbatim [general] parser
; ast_true + sip.h:686 verbatim `int rtsave_sysname; /*!< G: Save system
; name at registration? */` + chan_sip.c:19440 verbatim "Save sys. name"
; sip show settings display + canonical Asterisk chan_sip.c:5103-5151 canonical Asterisk-
; upstream realtime_update_peer implementation pattern (inline 2-var setup +
; appended `syslabel, sysname` pair to ast_update_realtime varargs;
; NULL-key pair = no-op when not active).
;
; IMPORTANT: active chan_sip.c (FuturePBX fork) has DROPPED the canonical
; realtime_update_peer implementation entirely — only parser + display present
; (rtsavesysname is currently a DEAD flag in active chan_sip; canonical
; implementation preserved only in canonical Asterisk chan_sip.c backup). chan_sofia restores
; canonical Asterisk-upstream behavior — chan_sofia parity-with-canonical-
; source-where-current-chan_sip-fork-regressed flavor.
;
; KNOWN BEHAVIOR CHANGE: chan_sofia prior
; to this commit silently-no-regserver-writes regardless of flag value;
; this ship restores canonical behavior. Restoration recipe: explicit
; rtsavesysname=no preserves prior chan_sofia silent-no-write baseline.
;
; Implementation matrix (5 sites):
;   chan_sofia.c:6253+6261 — REGISTER 200 OK realtime updates (initial
;                            registration site)
;   chan_sofia.c:6455+6462 — REGISTER 200 OK realtime updates (auth-OK
;                            path site)
;   chan_sofia.c:8447     — outbound REGISTER response handler realtime
;                           update (registration confirmation)
;
; Operator action items:
;   * operators with chan_sip [general] rtsavesysname=yes migrate verbatim
;     zero-rewrite — drop-in PARSE+EFFECT preserved (chan_sofia restores
;     canonical Asterisk-upstream behavior; chan_sip current-fork dead-flag
;     was effectively no-op anyway)
;   * operators with rtsavesysname=no (default): drop-in compat (chan_sofia
;     baseline preserved; no regserver writes)
;   * operators wanting per-instance multi-server tracking: set systemname=
;     in gabpbx.conf [options] + rtsavesysname=yes here; ast_update_realtime
;     calls will include regserver column at registration paths
;
; A sofia.conf with rtsavesysname=yes has that value honored on reload.
;
; Reload-required note: changing rtsavesysname= requires
; `module reload chan_sofia.so` to update parsed value; existing in-flight
; REGISTERs retain their original behavior until next REGISTER cycle.
;
;rtsavesysname = yes

;
; --- rtupdate (chan_sip parity, realtime DB write gate) ---
; chan_sip semantic: when yes (default), peer registration changes propagate
; to realtime DB via ast_update_realtime calls (ipaddr/port/regseconds/
; fullcontact + optional regserver per rtsavesysname). When no, realtime DB
; writes are SKIPPED — operators with cached-realtime peers (peer state cached
; in memory; DB churn unnecessary) get write-elimination optimization.
;
; chan_sip parity citations: chan_sip.c:29592-29593 verbatim [general] parser
; ast_true + chan_sip.c:29480 verbatim explicit default-init = TRUE + sip.h
; :685 verbatim field declaration (Update database with
; registration data for peer?) + chan_sip.c:19438 verbatim "Update:" sip show
; settings wording + 6 use sites at chan_sip.c L14630+L14743+L15094+L22080+
; L27569+L29221 (active chan_sip implementation CONFIRMED — NOT canonical-vs-current-
; fork-divergence class like rtsavesysname).
;
; chan_sofia implementation (combined-gate per chan_sip.c:14630+L14743
; verbatim combined-gate pattern): 3 sofia_process_register `if (peer->
; is_realtime)` blocks → `if (peer->is_realtime && sofia_cfg.peer_rtupdate)`.
; Covers 5 ast_update_realtime sites (initial REGISTER if/else block 2 calls
; + auth-OK REGISTER if/else block 2 calls + outbound REGISTER response 1
; call). rtupdate=no skips ALL realtime DB writes regardless of rtsavesysname.
;
; Operator action items:
;   * operators with chan_sip [general] rtupdate=yes (default) migrate
;     verbatim zero-rewrite — drop-in PARSE+EFFECT preserved (current
;     chan_sofia behavior preserved; ast_update_realtime calls fire as today)
;   * operators with rtupdate=no get NEW behavior (skip realtime DB writes
;     for cached-realtime optimization) — chan_sofia behavior change for
;     non-default operators (bounded chan_sip-parity feature-add)
;   * operators NOT setting rtupdate get default 1 = chan_sip drop-in
;     baseline preserved
;
; A sofia.conf with `;rtupdate=yes` commented (not active) has default behavior
; that matches the commented value; setting it explicitly gives a clean
; migration on reload.
;
; Reload-required note: changing rtupdate= requires
; `module reload chan_sofia.so` to update parsed value; existing in-flight
; REGISTERs retain their original behavior until next REGISTER cycle.
;
;rtupdate = yes

;
; --- register_pool (signalling resilience under a slow realtime DB) ---
; When yes, the realtime DB writes that a successful REGISTER performs
; (ast_update_realtime: ipaddr/port/regseconds/fullcontact) are handed to a
; small fixed pool of background worker threads instead of running inline on
; the single SIP signalling thread.  This keeps call signalling (INVITE/OPTIONS)
; responsive during a registration storm when the realtime database is slow —
; the worker pool absorbs the DB latency instead of head-of-line-blocking calls.
;
; Default no (off): REGISTER behaves exactly as before (the DB write runs
; inline).  Turning it on or off takes effect on `module reload chan_sofia.so`,
; so it doubles as a runtime kill-switch.
;
; Trade-off: with the pool on, the 200 OK is sent before the
; realtime row is persisted (eventual consistency).  The in-memory registration
; is authoritative immediately; only the DB row catches up a moment later.
; Lanes are keyed by account, so all writes for one peer stay STRICTLY ORDERED on
; one lane (a de-REGISTER can never overtake a prior REGISTER) — the lane is the
; single path; there is no inline bypass once the pool is on.  Under a slow DB the
; lane queue absorbs the backlog and drains; watch its depth in
; `core show taskprocessors` (the worker threads stay bounded regardless).  In a
; rare failure to enqueue (out of memory) the single update is logged and dropped,
; and the next REGISTER refresh re-writes the row.  If a worker DB write itself
; fails it is logged.  Only realtime peers with rtupdate=yes are affected.
;
; register_pool_workers sets the lane count; 0 (default) auto-sizes to about
; half the CPU cores (clamped 2..16).  The lanes appear in
; `core show taskprocessors` as sofia/regpool-NN.  NOTE: the lane count is fixed
; at the first time the pool is enabled and cannot change on reload (taskprocessors
; are not torn down at runtime) — changing register_pool_workers needs a full
; `systemctl restart gabpbx`.
;
;register_pool = no
;register_pool_workers = 0

;
; --- rtcachefriends (chan_sip parity, parse-compatibility only) ---
; chan_sip semantic: when yes, realtime peers are kept in memory after first
; lookup like static peers (speeds subsequent lookups; reduces DB churn;
; required for qualify-on-realtime per chan_sip.c:29046-29051). When no
; (default), realtime peers are destroyed after each lookup and re-fetched
; from DB on next access.
;
; chan_sip parity citations: chan_sip.c:29588-29589 verbatim [general] parser
; ast_set2_flag(global_flags[1], ast_true(v->value), SIP_PAGE2_RTCACHEFRIENDS)
; + sip.h:304 verbatim flag bit (1<<0) (Should we keep RT
; objects in memory for extended time?) + chan_sip.c:19437 verbatim "Cache
; Friends:" sip show settings wording + 15+ active use sites at L5285+L5622+
; L5624+L15010+L15061+L15081+L18272+L18276+L18343+L18365+L28585+L28619+
; L29046+L29051+L29310 (active chan_sip implementation confirmed — chan_sip parity).
;
; chan_sofia design rationale: ao2 peer registry already keeps ALL peers
; (static + realtime equivalently) in memory after first ao2_link. There's
; no "destroy after lookup" path in chan_sofia — chan_sofia ALWAYS caches
; realtime peers via ao2 registry. chan_sofia INTRINSIC behavior matches
; chan_sip rtcachefriends=YES regardless of flag value. PARSE-COMPAT-ONLY
; ship: parse + store + display but NO behavioral implementation (no destroy-
; after-lookup path to gate).
;
; Operator action items:
;   * operators with chan_sip [general] rtcachefriends=yes migrate verbatim
;     zero-rewrite — drop-in compat (chan_sofia intrinsic baseline matches;
;     ao2 caching = chan_sip rtcachefriends=yes effective behavior)
;   * operators with rtcachefriends=no expecting chan_sip destroy-after-
;     lookup semantic: KNOWN LIMITATION (chan_sofia infrastructure ABSENT;
;     chan_sofia continues caching all peers via ao2_link regardless of
;     flag value)
;   * operators wanting qualify-on-realtime: chan_sofia supports this
;     intrinsically (no rtcachefriends=yes prerequisite as chan_sip has)
;
; Future-fix path likely never needed — most operators want caching for
; performance. If operator demand surfaces for destroy-after-lookup
; semantic, implement realtime-peer-destroy-after-lookup mechanism in
; chan_sofia ao2 registry (~50-100 LoC follow-up).
;
; A sofia.conf with rtcachefriends=yes migrates cleanly and matches the
; chan_sofia intrinsic baseline: chan_sofia ao2 caching delivers the
; performance benefit the operator wanted.
;
; Reload-required note: changing rtcachefriends= requires
; `module reload chan_sofia.so` to update parsed value (no behavioral effect
; on caching — chan_sofia ao2 registry continues caching all peers regardless).
;
;rtcachefriends = yes

;
; --- rtautoclear (chan_sip parity, parse-compatibility only) ---
; chan_sip semantic: when flag set + peer is realtime, schedule peer
; expiration via AST_SCHED_REPLACE_UNREF after rtautoclear*1000 ms; on fire,
; ao2_unlink/destroy peer from sip_peers registry. Memory-management
; optimization for cached-realtime peer registries — auto-clears cache
; entries after registration expires (avoids unbounded ao2 growth from
; transient/short-lived peers).
;
; chan_sip parity citations: chan_sip.c:29652-29659 verbatim two-phase
; [general] parser (atoi+i>0 sets seconds; flag enabled when numeric > 0
; OR ast_true("yes")) + chan_sip.c:29477 verbatim explicit default-init =
; 120 seconds + sip.h:305 verbatim flag bit (1<<1) (Should
; we clean memory from peers after expiry?) + sip.h:688 verbatim int field
; + chan_sip.c:19441 verbatim "Auto Clear: %d (%s)" sip show settings
; TWO-PIECE display (int seconds + Enabled|Disabled flag state) + 3 active
; use sites at L5624 (peer-flag-propagation) + L5625-5626 (AST_SCHED_
; REPLACE_UNREF schedule peer expire) + L14684 (re-check at expire_register
; call).
;
; TWO-PIECE storage architecture per chan_sip parity:
;   * sofia_cfg.rtautoclear int (seconds value; default 120 chan_sip
;     drop-in)
;   * sofia_cfg.rtautoclear_enabled int (flag state; default 0 chan_sip
;     drop-in DISABLED)
;
; Operator usage forms (all chan_sip-faithful):
;   rtautoclear=120  → seconds=120 + flag=enabled
;   rtautoclear=300  → seconds=300 + flag=enabled
;   rtautoclear=yes  → seconds=120 default + flag=enabled
;   rtautoclear=no   → seconds=120 default + flag=disabled (DEFAULT)
;
; chan_sofia design rationale: ao2 peer registry has NO peer-level auto-
; clear infrastructure (sofia_expire_contacts_cb is per-AOR per-CONTACT
; expiry NOT peer-level; chan_sofia peers persist in ao2 registry until
; module reload). parse-compatibility only: parse + store + display but NO
; behavioral implementation.
;
; KNOWN LIMITATION: rtautoclear=N OR yes-set operators get parse-clean
; migration but chan_sofia continues caching realtime peers until reload
; regardless of flag value. Future-fix path: implement peer-level scheduler
; infrastructure (peer->autoclear_sched field + sofia_autoclear_cb
; scheduler callback + AST_SCHED_REPLACE_UNREF implementation at sofia_update_
; peer_contacts; ~50-100 LoC follow-up if operator demand surfaces).
;
; Operator action items:
;   * operators with chan_sip [general] rtautoclear=N/yes/no migrate
;     verbatim zero-rewrite — parse-clean migration; effective behavior
;     deferred (chan_sofia continues caching all peers regardless of flag
;     value)
;   * operators wanting chan_sip auto-clear semantic for memory management:
;     KNOWN LIMITATION (chan_sofia infrastructure ABSENT; future-fix path
;     documented above)
;   * operators NOT setting rtautoclear get default seconds=120 + flag=
;     disabled = chan_sip drop-in baseline preserved
;
; Reload-required note: changing rtautoclear= requires
; `module reload chan_sofia.so` to update parsed value (no behavioral
; effect — chan_sofia ao2 registry continues caching all peers regardless).
;
;rtautoclear = 120

;
