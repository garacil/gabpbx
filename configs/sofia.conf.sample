;promiscredir = yes

;
; --- matchexternaddrlocally / matchexterniplocally (chan_sip parity, PARSE-COMPAT-ONLY) ---
; chan_sip semantic: when set + localnet ACL configured + our IP is INSIDE
; localnet → don't substitute externaddr (treat our IP as local). Useful for
; NAT hairpin-edge-case where externaddr falls within localnet range —
; prevents hairpin-NAT confusion. When clear (default), chan_sip ALWAYS
; substitutes externaddr when peer is outside localnet regardless of where
; our IP sits.
;
; Dual-key acceptance: BOTH "matchexternaddrlocally" and "matchexterniplocally"
; spellings are parsed identically (chan_sip OR-chained acceptance — operators
; from either spelling-camp migrate verbatim).
;
; chan_sip parity citations: chan_sip.c:29954-29955 verbatim [general] dual-
; key OR-chained parser ast_true + chan_sip.c:29531 verbatim default-init via
; DEFAULT_MATCHEXTERNADDRLOCALLY (FALSE per sip.h:210) + sip.h:701 verbatim
; int field + chan_sip.c:4015-4024 verbatim use site at NAT-detection logic
; (peer-outside-localnet AND our-IP-inside-localnet check).
;
; chan_sofia design rationale: sofia_should_use_externaddr signature at
; chan_sofia.c:1471-1478 takes peer_addr ONLY (compares peer against
; localnet); chan_sip's L4024 logic compares OUR IP (us) against localnet —
; DIFFERENT parameter semantic. parse-compatibility only: parse + store +
; display but NO behavioral implementation (full chan_sip parity requires extending
; sofia_should_use_externaddr signature OR adding gate at sofia_resolve_ourip;
; ~25-35 LoC follow-up if operator demand surfaces).
;
; chan_sofia extension: sip show settings displays "Match extern locally: yes/no"
; at runtime — chan_sip silent at this CLI (chan_sip does NOT display
; matchexternaddrlocally; typical NAT operator-edge-case flag pattern).
;
; Operator action items:
;   * operators with chan_sip [general] matchexternaddrlocally= or
;     matchexterniplocally= (either spelling) migrate verbatim zero-rewrite
;     — parse-clean migration; effective behavior deferred (chan_sofia
;     sofia_should_use_externaddr signature divergence)
;   * operators with NAT hairpin-edge-case where externaddr falls within
;     localnet: KNOWN LIMITATION (chan_sofia infrastructure ABSENT; future-
;     fix path documented above)
;   * operators NOT setting either key get default 0 (FALSE) = chan_sip drop-
;     in baseline preserved (always substitute externaddr when peer outside
;     localnet)
;   * operator runs sip show settings — sees "Match extern locally: yes/no"
;     display 16th field (chan_sofia extension over chan_sip CLI absence)
;
; Reload-required note: changing either key requires `module
; reload chan_sofia.so` to update parsed value (no behavioral effect —
; chan_sofia sofia_should_use_externaddr continues current behavior).
;
;matchexternaddrlocally = yes
;matchexterniplocally = yes               ; ALIAS — same effect as above

;
; --- autoframing (chan_sip parity, parse-compatibility only) ---
; chan_sip semantic: when set, honor peer-advertised ptime/maxptime in inbound
; SDP via ast_codec_pref_setsize for codec packetization size. When clear
; (default), use fixed ptime from format prefs (chan_sip.c:12663 force config
; ptime via ast_rtp_codecs_packetization_set on incoming call).
;
; Use case: codec ptime negotiation for narrow-bandwidth scenarios with ptime-
; sensitive codecs (G.729/G.726 with non-default framesizes; e.g. G.729 with
; ptime=10 vs default ptime=20 for bandwidth optimization).
;
; chan_sip parity citations: chan_sip.c:28924-28925 verbatim per-peer parser
; ast_true (DIRECT build_peer parser NOT handle_common_options indirection)
; + chan_sip.c:29865-29866 verbatim [general] parser ast_true global_autoframing
; (SEPARATE per-peer + [general] parsers) + chan_sip.c:747 verbatim static
; unsigned int global_autoframing + chan_sip.c:29469 verbatim default-init = 0
; + sip.h:1018 + L1231 verbatim bit field declarations on sip_pvt + sip_peer
; + 5 inheritance sites L5942 + L8547 + L17021 + L17157 + L28459 + chan_sip.c
; :10415 verbatim use site at SDP parse direction (honor peer-advertised
; ptime when set) + chan_sip.c:12663 verbatim use site at SDP generate
; direction (force config ptime when clear + incoming) + 3 display sites
; (sip show peer L18728 + sip show user L18963 + sip show settings L19403).
;
; chan_sip parity confirmed.
;
; chan_sofia design rationale: sofia_parse_sdp infrastructure PRESENT (SDP
; attribute walker at chan_sofia.c:2210+ + gabpbx-core ast_codec_pref_setsize
; + ast_rtp_codecs_packetization_set APIs available); however autoframing
; gate not implemented today. parse-compatibility only: parse + store +
; display but NO behavioral implementation. Future-fix path: implement SDP ptime
; attribute walker in sofia_parse_sdp media loop + ast_codec_pref_setsize
; implementation (~50-70 LoC follow-up if operator demand surfaces).
;
; KNOWN LIMITATION: autoframing=yes operators expecting chan_sip ptime
; auto-detection get parse-clean migration but chan_sofia continues to use
; sofia-sip default ptime negotiation regardless of flag value.
;
; Operator action items:
;   * operators with chan_sip [general or per-peer] autoframing= migrate
;     verbatim zero-rewrite — parse-clean migration; effective behavior
;     deferred (chan_sofia sofia_parse_sdp ptime gate not wired today)
;   * operators wanting chan_sip ptime auto-detection for codec-specific
;     framesize negotiation: KNOWN LIMITATION (chan_sofia infrastructure-
;     present-but-not-wired; future-fix path documented above)
;   * operators NOT setting autoframing get default 0 (FALSE) = chan_sip
;     drop-in baseline preserved
;
; Reload-required note: changing autoframing= requires
; `module reload chan_sofia.so` to update parsed value (no behavioral
; effect — chan_sofia sofia_parse_sdp continues current behavior).
;
;autoframing = yes

;
; --- faxdetect (chan_sip parity, PARSE-COMPAT-ONLY 4-state multi-mode) ---
; chan_sip semantic: 4-state fax detection trigger flag (no/cng/t38/cng,t38/yes).
; When set, chan_sip detects inband fax CNG tones (via ast_dsp DSP_FEATURE_FAX_
; DETECT) AND/OR T.38 reinvite from peer; auto-switches call to fax handling.
; Multi-mode parser: yes → BOTH (cng+t38); no → NONE; comma-separated cng/t38
; → bit-OR combo. Default no (NONE).
;
; chan_sip parity citations: chan_sip.c:28202-28221 verbatim multi-mode parser
; via handle_common_options shared parser (per-peer L28671 + [general] L29544
; both reach same parser) + sip.h:341-344 verbatim 2-bit flag encoding (00=
; NONE / 01=CNG / 10=T38 / 11=BOTH) + chan_sip.c:29536 verbatim default-init
; via ast_clear_flag = NONE + 5+ active use sites L4945 enable_dsp_detect
; (DSP_FEATURE_FAX_DETECT when CNG flag) + L6282 T.38 reinvite trigger
; ast_clear_flag + L8186-8259 sip_rtp_read sets faxdetect=1 when DSP detects
; CNG tone + L8288 post-rtp-read handler triggers fax/T.38 reinvite when CNG
; flag + L10196 T38 reinvite check from peer.
;
; chan_sip parity (canonical Asterisk chan_sip.c L4856+L6249+L8047+L8120+L8149+
; L10057+L27963).
;
; chan_sofia design rationale: DSP infrastructure PRESENT (inband DTMF
; detection at chan_sofia.c:1795+ sofia_enable_dsp_detect helper + DSP_
; FEATURE_FAX_DETECT API available via gabpbx-core); however fax CNG detection
; is not yet implemented in chan_sofia. T.38
; reinvite infrastructure ABSENT (a future T.38 enhancement; no
; T.38 SDP handler in sofia_parse_sdp; no nua_invite re-INVITE T.38 trigger).
; parse-compatibility only: parse + store + display but NO behavioral implementation.
;
; KNOWN LIMITATION CLOSED: faxdetect=yes/cng/t38/
; cng,t38 now BEHAVIORAL — DSP_FEATURE_FAX_DETECT enabled per peer when
; faxdetect=cng (or cng,t38); ast_dsp_process emits AST_FRAME_DTMF subclass
; 'f' on CNG tone detection → sofia_read async-gotos channel into "fax"
; extension (chan_sip.c:8288 verbatim). Peer T.38 reINVITE arrival when
; faxdetect=t38 (or cng,t38) → sofia_parse_sdp async-gotos channel into
; "fax" extension (chan_sip.c:10196 verbatim). Dialplan fax extension runs
; SendFAX/ReceiveFAX which negotiates T.38 mode via setoption / control-
; frame chain (sofia_queryoption AST_OPTION_T38_STATE handler).
;
; Operator action items (BEHAVIORAL implementation):
;   * operators with chan_sip faxdetect=yes/no/cng/t38/cng,t38 migrate
;     verbatim zero-rewrite — chan_sip-parity behavior preserved END-TO-END
;   * faxdetect=cng triggers DSP-based CNG tone detection on inbound audio;
;     CNG-detected → async-goto channel to "fax" extension; dialplan
;     SendFAX/ReceiveFAX runs T.38 negotiation
;   * faxdetect=t38 triggers async-goto channel to "fax" extension on peer
;     T.38 reINVITE arrival; dialplan handles T.38 receive
;   * faxdetect=cng,t38 (or yes) enables BOTH triggers
;   * operators NOT setting faxdetect get default no (NONE) = chan_sip drop-
;     in baseline preserved
;
; A sofia.conf with faxdetect=no keeps the chan_sip drop-in default semantic,
; honored on reload as a clean migration matching operator intent.
;
; Reload-required note: changing faxdetect= requires
; `module reload chan_sofia.so` to update parsed value (no behavioral
; effect — chan_sofia continues current behavior).
;
;faxdetect = no            ; default
;faxdetect = yes           ; equivalent to "cng,t38" — enable both modes
;faxdetect = cng           ; CNG tone detection only
;faxdetect = t38           ; T.38 reinvite detection only
;faxdetect = cng,t38       ; BOTH modes (same as "yes")

;
; --- Message Waiting Indication (per-peer mailbox + subscribemwi) ---
; mailbox = <mbox>[@<context>][,<mbox>@<context>...]  — voicemail mailbox(es) whose state this peer's
;   phone reflects. On a change, chan_sofia delivers MWI to the phone.
; subscribemwi (chan_sip parity, default no):
;   no  (default) — UNSOLICITED MWI: the phone does NOT need to SUBSCRIBE; chan_sofia pushes a
;                   message-summary NOTIFY to its registered contact on each successful REGISTER and
;                   whenever the mailbox count changes (RFC 3842, Subscription-State: active).
;   yes           — SUBSCRIBE-only: MWI is sent only on an active inbound MWI SUBSCRIBE dialog; no
;                   unsolicited push. Use for phones that subscribe for MWI themselves.
;   A subscribing phone keeps getting solicited NOTIFYs on its dialog regardless; the unsolicited push
;   only fires when there is no active subscription, so there is no double-notify.
;mailbox=1234@default
;subscribemwi=no
;
; --- mwiexpiry / mwiexpirey / mwi_expiry (chan_sip parity, parser-naming-fix) ---
; MWI subscription default expiry seconds. Default 3600 (chan_sip
; DEFAULT_MWI_EXPIRY parity at sip.h:58). atoi value < 1 clamps to 3600.
;
; chan_sip semantic: chan_sip-CLIENT outbound SUBSCRIBE refresh-timer for
; subscribing TO another server's MWI; chan_sip.c:13378 sets mwi->call->
; expiry; chan_sip.c:21749 ast_sched_add(sched, mwi_expiry * 1000, ...) for
; refresh interval. chan_sofia uses field for SERVER-side outbound NOTIFY
; Expires header per RFC 6665 (notifier at chan_sofia.c:8339) — same
; time interval, different direction; same field serves both purposes
; correctly. ALSO used as the Expires of the OUTBOUND MWI SUBSCRIBE that
; chan_sofia sends as a WATCHER (per-peer mwi_subscribe=, see that key);
; sofia-sip auto-refreshes that subscription on this interval.
;
; chan_sip parity citations: chan_sip.c:29775-29782 verbatim [general] dual-
; key parser (mwiexpiry + mwiexpirey alternate spelling — BOTH spellings
; parsed identically via OR-chained acceptance) + chan_sip.c:570 verbatim
; static int mwi_expiry + sip.h:58 verbatim DEFAULT_MWI_EXPIRY = 3600.
; chan_sip parity (canonical Asterisk chan_sip.c L561+L29514-29517).
;
; chan_sofia 3-spelling OR-chained acceptance:
;   * mwi_expiry  — chan_sofia historical (with underscore)
;   * mwiexpiry   — chan_sip primary verbatim spelling
;   * mwiexpirey  — chan_sip alternate spelling (typo preserved for drop-in
;                   compat — operators historically use either)
; All 3 spellings parse identically into sofia_cfg.mwi_expiry int field.
;
; **NOT PARSE-COMPAT-ONLY** — full chan_sip-faithful semantic active
; immediately via the existing implementation (chan_sofia infrastructure-PRESENT enabled
; reduced parser-naming-fix scope,
; analogous to the domainsasrealm chan_sofia-domain-list-infrastructure-
; PRESENT precedent). Parser extension achieves chan_sip drop-in compat
; without breaking the chan_sofia-naming work.
;
; chan_sofia extension: sip show settings displays "MWI expiry: %d" at
; runtime — chan_sip silent at this CLI (chan_sip does NOT display
; mwi_expiry at sip show settings; verified via grep).
;
; Operator action items:
;   * operators with chan_sip [general] mwiexpiry= or mwiexpirey= migrate
;     verbatim zero-rewrite — drop-in PARSE+EFFECT preserved (full chan_sip-
;     faithful implementation active)
;   * operators with chan_sofia historical mwi_expiry= continue to work
;     unchanged via 3-spelling OR-chained acceptance (compat preserved)
;   * operators NOT setting either spelling get default 3600 seconds = chan_
;     sip drop-in baseline preserved per explicit-init
;
; Reload-required note: changing any spelling requires
; `module reload chan_sofia.so` to update parsed value; in-flight MWI
; subscriptions retain their original Expires until next refresh cycle.
;
;mwiexpiry = 3600         ; chan_sip primary spelling
;mwiexpirey = 3600        ; chan_sip alternate spelling
;mwi_expiry = 3600        ; chan_sofia historical spelling

;
; --- timerb (chan_sip parity) ---
; chan_sip semantic: RFC 3261 §17.1.1.2 INVITE transaction timeout — Timer B
; caps INVITE retry at this duration (ms); after timeout, 408 Request Timeout
; final response. Default 32000ms (64 * 500ms T1) per chan_sip drop-in.
;
; chan_sip parity citations: chan_sip.c:28947-28952 verbatim per-peer parser
; DIRECT-build_peer (NOT handle_common_options indirection) sscanf %30d +
; clamp-to-default-on-invalid-or-<200 + LOG_WARNING + chan_sip.c:29601-29607
; verbatim [general] parser **with chan_sip BUG** (see below) + chan_sip.c
; :745-746 verbatim globals + chan_sip.c:29522 verbatim default-init = 64 *
; DEFAULT_TIMER_T1 (32000ms) + sip.h:1024 + L1285 verbatim int field
; declarations + chan_sip.c:4519 + L6030-6033 + L17061-17064 inheritance use
; sites + chan_sip.c:6354 ast_sched_add per-pvt scheduler + L18697 sip show
; peer + L19412 sip show settings displays.
;
; **Known chan_sip parser difference**: chan_sip.c:29601-29607 parses
; `int tmp = atoi(v->value)` but
; ONLY assigns to global_timer_b in `< 500` invalid-value branch — valid
; values ≥ 500 are PARSED via atoi but NEVER ASSIGNED to global_timer_b!
; Operator setting [general] timerb=10000 in chan_sip.conf has NO effect;
; global_timer_b stays at L29522 default 32000ms regardless. **chan_sofia
; handling**: chan_sofia [general]
; parser correctly assigns valid values via missing-`else` branch fix —
; chan_sip operators get CORRECT behavior under chan_sofia where chan_sip
; silently ignored their valid timerb settings.
;
; **Implementation** via TAG_IF(default_
; timer_b, NTATAG_SIP_T1X64(default_timer_b)) at nua_create — sofia-sip
; native gate at nta_tag.h:182-186 verbatim NTATAG_SIP_T1X64(x) macro
; applies T1*64 (Timer B) globally via NTA-layer transaction timeout setting.
; Mirrors the NTATAG_SIP_T1 t1min precedent —
; single global implementation covering all NTA-layer transactions; per-peer dynamic
; override deferred (per-peer-dynamic-deferral repeat
; per the t1min precedent).
;
; **chan_sofia** uses a single nua_create tag-
; emit-site vs chan_sip per-pvt ast_sched_add scheduler at chan_sip.c:6354
; (sofia-sip absorbs per-transaction Timer B into NTA layer transparently).
;
; **Two chan_sofia differences vs chan_sip**:
;   (A) NTATAG_SIP_T1X64 nua_create
;       single global NTA setting vs chan_sip per-pvt-scheduler
;   (B) chan_sofia validates the range where the chan_sip [general] parser does not
;
; Operator action items:
;   * operators with chan_sip [general] timerb= migrate verbatim zero-rewrite
;     — chan_sofia parser correctly assigns valid values (the chan_sip parser
;     would silently ignore!); operators get drop-in PARSE+EFFECT+CORRECT
;     behavior
;   * operators with per-peer timerb= migrate verbatim zero-rewrite — drop-in
;     PARSE preserved; per-peer dynamic override deferred per the t1min
;     precedent (peer field stored + displayed but NTATAG_SIP_T1X64 nua_create
;     implementation serves global default only)
;   * operators NOT setting timerb get default 32000ms = chan_sip drop-in
;     baseline preserved (sofia-sip default with NTATAG_SIP_T1X64 implementation)
;   * operator runs sip show peer + sip show settings + AMI SIPshowpeer —
;     sees Timer B 32000ms display (20th field) on
;     sofia_cli_show_settings field count
;
; Reload-required note: changing timerb= requires `module
; reload chan_sofia.so` to update parsed value; nua_create re-instantiated on
; reload picks up new NTATAG_SIP_T1X64 setting; in-flight transactions retain
; their original Timer B until completion.
;
;timerb = 32000          ; default 64 * T1 = 32 seconds
;timerb = 20000          ; tighter 20-second timeout
;timerb = 64000          ; loose 64-second timeout for poor networks

;
; --- timert1 (chan_sip parity) ---
; chan_sip semantic: RFC 3261 §17.1.1.1 T1 — initial retransmission interval
; (ms). Initial duration for request retransmission timers A and E (UDP) and
; response retransmission timer G. Default 500ms per chan_sip drop-in
; (DEFAULT_TIMER_T1 = 500 at sip.h:89).
;
; chan_sip parity citations: chan_sip.c:744 verbatim static int global_t1 +
; chan_sip.c:28482 verbatim peer_alloc inheritance + chan_sip.c:28941-28946
; verbatim per-peer parser DIRECT-build_peer triple-clamp (sscanf %30d +
; val < 200 || val < global_t1min → LOG_WARNING + fallback peer->timer_t1
; = global_t1min + timert1_set = 1) + chan_sip.c:29521 verbatim default-init
; global_t1 = DEFAULT_TIMER_T1 + chan_sip.c:29596-29600 verbatim [general]
; parser bare atoi NO-range-validation (chan_sip parser-class — chan_sofia
; the same range validation applies; mirrors the timerb
; precedent) + chan_sip.c:30038-30040 verbatim T1 vs t1min cross-validation
; + chan_sip.c:30043-30055 verbatim Timer B vs T1*64 nested cross-validation
; (with timerb_set/timert1_set flag-tracking) + sip.h:89 verbatim DEFAULT_
; TIMER_T1 = 500 + chan_sip.c:19410 verbatim "Timer T1: %d" sip show settings
; display + chan_sip.c:18697 sip show peer "Timer T1" display.
;
; chan_sip parity (canonical Asterisk chan_sip.c).
;
; **Fix**: earlier chan_sofia builds (since the t1min
; work) used sofia_cfg.t1min default (100ms per chan_sip DEFAULT_T1MIN)
; as NTATAG_SIP_T1 argument at chan_sofia.c:9537 — but per sofia-sip
; nta_tag.c:497-500 docstring "Initial retransmission interval used by
; request retransmission timers A and E (UDP) and response retransmission
; timer G" + default 500ms, NTATAG_SIP_T1 is the T1 VALUE not the t1min
; minimum-bound. chan_sofia passes NTATAG_SIP_T1(sofia_cfg.default_timer_t1),
; not sofia_cfg.t1min. **Operational impact**: chan_sofia retransmits at 500ms
; intervals (matching chan_sip default) rather than the more aggressive 100ms
; intervals earlier builds used — a 5× change toward the chan_sip drop-in
; baseline. Affects ALL SIP transactions globally (UDP request
; retransmits timer A+E + response retransmit timer G all use this T1
; value per RFC 3261 §17.1.1.2).
;
; **Two chan_sofia differences vs chan_sip**:
;   (A) range validation the chan_sip [general] parser omits
;       (chan_sip uses bare global_t1 = atoi(v->value) at
;       L29596-29600 with no parse-time range check; chan_sofia adds sscanf
;       %30d + < 200 clamp + LOG_WARNING + clamp-to-DEFAULT_TIMER_T1; mirrors
;       the timerb range-validation precedent)
;   (B) chan_sofia uses sofia_cfg.default_timer_t1 for NTATAG_SIP_T1
;       (correcting the earlier t1min misuse at chan_sofia.c:9537)
;
; Implementation via NTATAG_SIP_T1(default_timer_
; t1) at nua_create — sofia-sip native gate at nta_tag.h:176-177 verbatim
; macro applies T1 retransmission interval globally via NTA-layer.
;
; **chan_sofia** uses a single nua_create
; tag-emit-site vs chan_sip per-pvt T1 selection at chan_sip.c:6024+L17056
; (sofia-sip absorbs per-transaction T1 into NTA layer transparently).
;
; Per-peer dynamic-T1 override
; deferred per established NTATAG_*_T1 family deferral consistency
; (t1min + timerb + this timert1). Future-fix path: per-peer dynamic-T1 override
; via nua_set_hparams() at sofia_create_handle when operator demand
; surfaces (~15-20 LoC follow-up).
;
; Operator action items:
;   * operators with chan_sip [general] timert1= migrate verbatim zero-
;     rewrite — chan_sofia parser CORRECTLY adds parse-time range
;     validation chan_sip lacks; operators get drop-in PARSE+EFFECT+
;     CORRECT-VALIDATION behavior
;   * operators with per-peer timert1= migrate verbatim zero-rewrite —
;     drop-in PARSE preserved (triple-clamp matches chan_sip-faithful
;     fallback-to-t1min floor semantic); per-peer dynamic override
;     deferred (future item)
;   * operators NOT setting timert1 get default 500ms = chan_sip drop-in
;     baseline preserved (NTATAG_SIP_T1 implementation changed to
;     default_timer_t1 from prior latent-bug t1min)
;   * operators upgrading from pre-this-commit see 5× retransmit-rate
;     change toward chan_sip drop-in baseline (100ms → 500ms initial T1)
;   * operator runs sip show peer + sip show settings + AMI SIPshowpeer —
;     sees Timer T1 500ms display 21st field on sofia_cli_show_settings
;
; Reload-required note: changing timert1= requires
; `module reload chan_sofia.so` to update parsed value; nua_create re-
; instantiated on reload picks up new NTATAG_SIP_T1 setting; in-flight
; transactions retain their original T1 until completion.
;
;timert1 = 500           ; default RFC 3261 chan_sip-faithful baseline
;timert1 = 1000          ; longer 1-second initial T1 for high-latency networks
;timert1 = 250           ; tighter 250ms T1 for private LAN (NOTE: must be ≥ t1min)

;
; --- allowoverlap (chan_sip parity, 3 sites) ---
; chan_sip semantic: per-peer + [general] tri-state RFC 3261 §3 digit-by-digit
; (overlap) dialing control. Values yes / no / dtmf. When yes (default), partial-
; extension INVITE returns "484 Address Incomplete" letting caller-side endpoint
; send subsequent digits in further INVITEs. When no, partial-extension INVITE
; returns "404 Not Found". When dtmf, parsed + stored + displayed but treated
; as fall-through to standard handling per chan_sip own design at chan_sip.c
; :23937-23943 verbatim dialplan-deferral comment "For SIP_PAGE2_ALLOWOVERLAP_
; DTMF it is better to do this in the dialplan using the Incomplete application
; rather than having the channel driver do it" — chan_sip itself defers DTMF
; detection to dialplan; chan_sofia mirrors verbatim.
;
; chan_sip parity at chan_sip.c:28188-28195 verbatim per-peer parser via
; handle_common_options + sip.h:318-322 verbatim 2-bit-flag-encoding-at-pos-13
; SIP_PAGE2_ALLOWOVERLAP NO/YES/DTMF/SPARE + chan_sip.c:29479 verbatim default-
; init `ast_set_flag(&global_flags[1], SIP_PAGE2_ALLOWOVERLAP_YES); /* Default
; for all devices: Yes */`. CRITICAL chan_sip drop-in: operators with NO
; explicit allowoverlap config get YES behavior — this is a behavior-change-
; from-chan_sofia-pre-baseline (chan_sofia previously had NO overlap-dial
; behavior at all).
;
; chan_sofia implements this at 3 sites:
;   (A) sofia_process_invite ast_canmatch_extension dual-test mirroring
;       chan_sip.c:16491-16497 verbatim get_destination MATCHMORE-detect helper
;       + chan_sip.c:23930-23934 verbatim handle_request_invite SIP_GET_DEST_
;       EXTEN_MATCHMORE → 484 emit. peer->allowoverlap_mode == YES + extension
;       NOT exact-match BUT canmatch (partial-match) → nua_respond(SIP_484_
;       ADDRESS_INCOMPLETE) + ao2 cleanup + early-return BEFORE sofia_new (no
;       PBX dispatch).
;   (B) sofia_indicate AST_CONTROL_INCOMPLETE case mirroring chan_sip.c:7661-
;       7669 verbatim dialplan-driven Incomplete-app path. peer->allowoverlap
;       _mode == YES → emit 484 via nua_respond; DTMF → wait for inband DTMF
;       digits no-op; NO → emit 404 Not Found.
;   (C) nua_r_invite 484 status special-case mirroring chan_sip.c:22508-22518
;       verbatim outbound 484 response handling. peer->allowoverlap_mode ==
;       YES → ast_queue_hangup_with_cause AST_CAUSE_INVALID_NUMBER_FORMAT (484
;       native semantic per hangup_sip2cause); NO/DTMF → AST_CAUSE_UNALLOCATED
;       (404 semantic — hides overlap-dial reality from caller).
;
; helper sofia_allowoverlap_str (3 callsites: sip show settings + sip show peer + AMI
; SIPshowpeer ≥ 3-callsite extraction threshold). chan_sofia extension over
; chan_sip on AMI side: chan_sip AMI silent on overlap-dial mode (verified via
; grep ABSENT); chan_sofia adds AMI SIPshowpeer "OverlapDial: %s" — CLI-
; exposure-where-chan_sip-silent dimension joins autodomain + matchexternaddr
; locally + subscribe_network_change_event precedent.
;
; CRITICAL chan_sip drop-in baseline: operators upgrading from chan_sip retain
; identical overlap-dialing behavior — partial-extension INVITEs that previously
; got 484 Address Incomplete continue to get 484 Address Incomplete; partial-
; extension INVITEs that previously got 404 Not Found (operators with explicit
; allowoverlap=no) continue to get 404 Not Found.
;
; Use cases:
;   * digit-by-digit dialing from analog phone with PSTN gateway emitting
;     individual INVITEs per pressed digit
;   * SIP phone in en-bloc mode that benefits from 484-driven retry loops
;     when extensions match prefix-only
;   * DTMF mode: dialplan executes Incomplete() application to collect digits
;     from inband DTMF + dispatch via Goto when extension complete
;
; Reload-required note: changing allowoverlap= requires
; `module reload chan_sofia.so` to update parsed value; in-flight INVITE
; processing retains the original mode until completion.
;
;allowoverlap = yes        ; default chan_sip-faithful baseline (484 on partial-match)
;allowoverlap = no         ; strict (404 on partial-match)
;allowoverlap = dtmf       ; parsed + stored but treated as fall-through (dialplan-deferred)

;
; --- autocreatepeer (chan_sip parity, parse-compatibility only) ---
; chan_sip semantic: when yes, REGISTER from an unknown peer triggers automatic
; creation of a temporary peer entry via temp_peer() helper at chan_sip.c:15880.
; Default no per chan_sip drop-in (sip.h:209 verbatim DEFAULT_AUTOCREATEPEER FALSE)
; — most operators leave default off (auto-create-from-unknown-REGISTER is a
; security anti-pattern). chan_sip's own fallback when alwaysauthreject is set
; AND autocreatepeer is no (the typical case): use bogus_peer challenge at
; chan_sip.c:15807 — exactly matches chan_sofia behavior.
;
; KNOWN LIMITATION: chan_sofia design refuses
; to auto-create unknown peers — security-stronger via alwaysauthreject,
; which routes unknown-peer REGISTER through sofia_send_auth_challenge
; with a 401 silent challenge regardless of this flag. parse-compatibility only:
; value is parsed + stored + reload-clean for chan_sip drop-in zero-rewrite
; migration; flag has NO behavioral effect on chan_sofia today.
;
; chan_sip default-no operators see ZERO behavior change (chan_sofia matches
; the alwaysauthreject + !autocreatepeer = bogus_peer behavior). Rare chan_sip
; autocreatepeer=yes operators get parse-clean migration with KNOWN LIMITATION
; (chan_sofia security-stronger refuses auto-create regardless).
;
; Future-fix path: implement sofia_create_temp_peer helper if operator demand
; surfaces — likely-never-needed (chan_sip default also FALSE; security-anti-pattern).
;
; chan_sip parity citations: chan_sip.c:29752-29753 [general] parser + L29468
; default-init + sip.h:209 + L15880-15883 use site temp_peer + L15807
; alwaysauthreject + !autocreatepeer bogus_peer interaction.
;
;autocreatepeer = no    ; default; PARSE-COMPAT-ONLY today (effect-deferred; security-stronger via alwaysauthreject)

;
; --- dynamic_exclude_static (chan_sip parity, security hardening) ---
; When yes, peer-build appends static peer IPs to the global contact_ha as DENY
; rules. Subsequent REGISTER processing rejects any Contact pointing to a
; static-peer IP via the existing contact_ha apply infrastructure.
; Use case: prevents dynamic peers from claiming static peer IPs and
; stealing calls. Default no per chan_sip drop-in (chan_sip.c:29481 verbatim).
;
; chan_sip parity citations: chan_sip.c:29644-29645 verbatim dual-key parser
; (variant spellings dynamic_exclude_static + dynamic_excludes_static both
; accepted) + L29481 default-init = 0 + L759 static field + L29164 verbatim
; peer-build-time mechanism (ast_append_ha "deny" peer->addr to contact_ha).
;
; chan_sofia revised mechanism leverages the existing contact_ha
; infrastructure: peer-build at sofia_parse_peer_config + sofia_apply_peer_variables
; conclusions appends static-peer-IP to sofia_cfg.contact_ha as deny rule;
; sofia_process_register applies contact_ha at L5398-5405 (no new REGISTER-
; rejection logic needed).
;
;dynamic_exclude_static = yes
;dynamic_excludes_static = yes    ; variant spelling — both accepted per chan_sip drop-in

;
; --- notifyringing (chan_sip parity, parse-compatibility only) ---
; chan_sip uses this flag inside cb_extensionstate to gate "early" vs "confirmed"
; presence state in BLF/dialog-info NOTIFY emissions when subscribed extensions
; are RINGING. Default yes per chan_sip drop-in critical default (sip.h:206
; verbatim DEFAULT_NOTIFYRINGING TRUE).
;
; KNOWN LIMITATION: chan_sofia presence/dialog-info NOTIFY
; infrastructure ABSENT (subscribecontext data-infrastructure pivot deferred).
; PARSE-COMPAT-ONLY: value is parsed + stored +
; reload-clean for chan_sip drop-in zero-rewrite migration; flag has NO behavioral
; effect today (chan_sofia silent on presence regardless of setting).
;
; Future-fix path: implement presence/dialog-info subscription handler
; (~150-300 LoC follow-up if operator demand surfaces); flag implementation becomes
; trivial once that handler lands.
;
; chan_sip parity citations: chan_sip.c:29689-29690 [general] parser + L29446
; default-init + sip.h:206 + cb_extensionstate use sites L13452+L13550.
;
;notifyringing = yes    ; default; PARSE-COMPAT-ONLY today (effect-deferred)

;
; --- notifyhold (chan_sip parity, drop-in peer onHold counter gate) ---
; When yes, chan_sofia tracks per-peer on-hold call count via peer->onHold
; atomic counter (incremented on hold transition; decremented on unhold).
; Counter is consumed by `sip show inuse` + AMI SIPshowpeer "OnHold" field.
; Default no per chan_sip drop-in (chan_sip.c:29448 verbatim default-init FALSE).
;
; chan_sip parity citations: chan_sip.c:29691-29692 [general] parser ast_true +
; L29448 default-init + L9477-9478 sip_peer_hold gate (peer-counter tracking).
;
; NOTE: chan_sip notifyhold gates peer-counter tracking
; ONLY — NOT AMI Hold event emission. AMI Hold in chan_sip is gated on
; sip_cfg.callevents (different flag); chan_sofia AMI Hold emission at
; sofia_process_reinvite is unconditional regardless of notifyhold (matches
; chan_sip callevents=yes typical case). Operators using sip show inuse /
; SIPshowpeer onHold see counter freeze when notifyhold=no — minor counter-
; tracking divergence from prior chan_sofia always-tracked baseline; chan_sip-
; drop-in correction toward chan_sip-faithful semantics. A sofia.conf with
; notifyhold=yes has counter tracking unchanged.
;
;notifyhold = yes

;
; --- use_q850_reason (RFC 3326 Q.850 Reason header — [general], both directions) ---
; When yes, chan_sofia stamps a "Reason: Q.850;cause=N;text=..." header on the BYE/CANCEL it sends AND on
; INVITE-rejection responses (404/480/484/486/488/503, etc.), built from the channel hangup cause or, for
; pre-channel rejects, mapped from the SIP status (chan_sip parity). It also maps a received Q.850 Reason
; on an inbound BYE/CANCEL back to the AST hangup cause (for CDR/billing fidelity). Default no.
;
;use_q850_reason = yes

;
; --- shrinkcallerid (chan_sip parity, drop-in CID normalization) ---
; When yes (default), CID phone-number strings are normalized: strip leading "+"
; and parens (e.g. "+1234567890" → "1234567890", "(555)123" → "555123") via
; ast_is_shrinkable_phonenumber gate + ast_shrink_phone_number. Default yes per
; chan_sip drop-in critical default (chan_sip.c:29526 verbatim default-init = 1).
;
; KNOWN BEHAVIOR CHANGE: prior chan_sofia baseline did NOT normalize CIDs (silent-baseline-no-
; normalization); this task ships chan_sip-verbatim default = 1, so CIDs with
; leading "+" or parens are now normalized at sofia_process_invite. Operators
; preferring the prior silent-baseline restoration set [general] shrinkcallerid=no
; explicitly. Bounded-impact: only CID phone-number strings affected (non-phone-
; number CIDs like "John Doe" unchanged regardless of setting via
; ast_is_shrinkable_phonenumber gate).
;
; chan_sip parity citations: chan_sip.c:30001-30009 [general] tri-state parser
; ast_true/ast_false + LOG_WARNING-on-invalid + L29526 default-init + L726
; static field + 4 use sites L16080+L16196+L17103+L17252.
;
;shrinkcallerid = yes

;
; --- apply_peer_callerid (chan_sip parity, inbound caller-ID policy) ---
; On an inbound INVITE from a matched/authenticated peer, whether to force that peer's
; configured `callerid` (number + name) onto the call — overriding the caller-ID the phone
; put in its From header — when no TRUSTED RPID/PAI identity was accepted. This is the
; chan_sip behavior (chan_sip.c:17113-17124): a peer that logs in with one SIP username but
; has callerid=<number> presents <number> on its outbound calls, instead of leaking its SIP
; username into the From (which upstream proxies may reject).
;
;   yes  - (DEFAULT, chan_sip parity) force the peer's callerid on inbound. A trusted
;          RPID/PAI (trustrpid=yes + a valid P-Asserted-Identity/Remote-Party-ID) still
;          wins and is NOT overridden. shrinkcallerid still applies. Peers with no callerid
;          configured are unchanged.
;   no   - keep the inbound From user as the caller-ID (pass-through).
;
; SOURCE OF TRUTH is the peer `callerid` field (config or realtime):
;   1. peer `callerid` populates the peer's cid_num / cid_name (ast_callerid_split);
;   2. on the inbound leg, apply_peer_callerid copies those into the channel caller-ID
;      (when no trusted RPID/PAI was accepted);
;   3. the outbound From then presents that channel caller-ID.
; Set the presented number/name in the peer `callerid` (or `cid_number`/`cid_name`). The
; driver does NOT transform the value (no prefix-stripping).
;
; A dialplan `Set(CALLERID(num/name)=...)` is an OPTIONAL later override only (it runs after
; the inbound channel is created); it is not the mechanism — the peer `callerid` is.
;
;apply_peer_callerid = yes

;
; --- callerid ([general] default caller-ID identity, chan_sip default_callerid parity) ---
; The fallback caller-ID presented in the outbound From when NOTHING else resolves an
; identity — i.e. no channel/connected-line caller-ID (dialplan or apply_peer_callerid),
; no peer cid_num, and no fromuser. This mirrors chan_sip's [general] callerid /
; default_callerid (default "gabpbx"). chan_sofia NEVER uses the peer/section name as a
; From identity (that would leak the account/auth name); this default is used instead.
; It does NOT override a real caller-ID — it is only the last-resort fallback.
;
;callerid = gabpbx

;
; --- legacy_useroption_parsing (chan_sip parity, PARSE-COMPAT-ONLY) ---
; chan_sip strips trailing semicolons from URI user-fields post-parse for legacy
; SIP UAs that put options in the user field with semicolons. Default no per
; chan_sip drop-in (sip.h:216 DEFAULT_LEGACY_USEROPTION_PARSING=FALSE).
;
; KNOWN LIMITATION: chan_sofia parse-compatibility only
; — value is parsed + stored + reload-clean for operators with chan_sip configs
; containing legacy_useroption_parsing=, but the full-feature URI per-component
; semicolon-strip is DEFERRED. ROOT CAUSE: sofia-sip ZERO native URI per-
; component-rewrite gate (verified in sofia-sip url_t parser API — no post-parse
; semicolon-strip hook). chan_sofia delegates URI parsing to sofia-sip below the
; per-component-rewrite point; no interception available without invasive sofia-sip
; patch. chan_sip parity citations: chan_sip.c:14818-14828 parse_uri_legacy_check
; function body + 7 use sites (L14847+L14988+L15743+L16369+L16397+L16819+L17225).
;
; Most operators don't need this flag — chan_sofia URI parsing is already RFC
; 3261-compliant via sofia-sip. Future-fix path: upstream sofia-sip exposes
; per-component-rewrite hook → chan_sofia adds the implementation at URI-parse callbacks.
;
;legacy_useroption_parsing = no    ; default; PARSE-COMPAT-ONLY today (effect-deferred per sofia-sip-library-feature-absence)

;
; --- match_auth_username (chan_sip parity, drop-in security-relevant) ---
; When yes, peer lookup uses the Authorization (or Proxy-Authorization) digest
; username instead of the From header's user-part. Use case: multi-identity
; scenarios where the From header doesn't reliably identify the peer (e.g.,
; sub-account or anti-spoofing setups where the digest credential is the
; trusted peer-identifier, not the From header an attacker can forge).
; Default no per chan_sip drop-in (chan_sip.c:29472 verbatim FALSE init).
; chan_sip parity chan_sip.c:29754-29755 [general] parser + L17258-17277
; Authorization → Proxy-Authorization fallback chain semantic.
;
;match_auth_username = yes

;
; --- maxcallbitrate (chan_sip parity, drop-in SDP video bandwidth) ---
; Per-call video bandwidth ceiling (kbps) emitted as "b=CT:%d" media-level
; attribute per RFC 4566 §5.8 inside the m=video block. Default 384 per
; chan_sip sip.h:218 DEFAULT_MAX_CALL_BITRATE — chan_sip drop-in.
;
; KNOWN BEHAVIOR CHANGE: prior chan_sofia
; baseline emitted NO b=CT line on video SDPs (silent default); this task
; ships chan_sip-verbatim 384-kbps default, so every video SDP now emits
; b=CT:384 by default. Audio-only operators see ZERO change (b=CT is gated
; inside if (needvideo) per chan_sip.c:12285). Operators preferring the
; prior silent-baseline restoration set [general] maxcallbitrate=0 explicitly
; (peers can also override via per-peer maxcallbitrate=N).
;
;maxcallbitrate = 384

;
; --- ignoreregexpire (chan_sip parity, drop-in stable-trunk preserve) ---
; When yes, expired SIP registrations are NOT removed from the contact set.
; Preserves the last-known contact across short upstream-trunk outages (stable
; PSTN gateway with intermittent network drops, carrier softswitch-style routing). When
; no (default), expired contacts are removed normally by the periodic cleanup
; pass. chan_sip parity chan_sip.c:29594-29595 [general] parser + L14625-14637
; destroy_association cleanup-skip-when-set. chan_sip operator scripts with
; ignoreregexpire= migrate verbatim zero-rewrite.
;
;ignoreregexpire = yes

;
; SDES-SRTP per RFC 4568. Default no.
; Requires res_srtp.so loaded; auto-disabled with WARNING if absent at load.
; Mandatory cipher AES_CM_128_HMAC_SHA1_80; AES_CM_128_HMAC_SHA1_32 accepted on inbound.
; encryption=yes peers reject any offer/answer that lacks a valid a=crypto with 488.
; Pairs naturally with TLS signaling (tlsbindport / wssbindport above).
;
;encryption     = no

;
; SRTP cipher preference (srtpcipher operator option, RFC 4568 §6.1
; multi-line a=crypto:N + RFC 6188 AES-CM-192/256 + RFC 7714 AES-GCM-128/256).
; Comma-separated list of suite names; chan_sofia emits one a=crypto:N line per
; recognized suite in operator-supplied order. Peer answers with the chosen tag.
; Empty default falls back to single-line AES_CM_128_HMAC_SHA1_80 (chan_sip
; backwards-compat). Per-peer srtpcipher= overrides this default.
; Recognized suites: AES_CM_128_HMAC_SHA1_80 / AES_CM_128_HMAC_SHA1_32 /
;   AES_CM_192_HMAC_SHA1_80 / AES_CM_192_HMAC_SHA1_32 /
;   AES_CM_256_HMAC_SHA1_80 / AES_CM_256_HMAC_SHA1_32 /
;   AEAD_AES_128_GCM / AEAD_AES_256_GCM
; Unknown names are skipped at offer-emit time with LOG_WARNING.
;
;default_srtpcipher = AEAD_AES_256_GCM,AEAD_AES_128_GCM,AES_CM_256_HMAC_SHA1_80,AES_CM_128_HMAC_SHA1_80    ; WebRTC-friendly GCM-first, AES-CM-128 backstop

;
; SRTP per-suite-fresh-key option (deferred from the multi-cipher offer work,
; strategy (b) — chan_sofia extension feature-not-in-chan_sip-at-
; all; chan_sip has no multi-suite SRTP offer mechanism therefore no chan_sip
; equivalent baseline). When enabled AND multi-cipher offer mode active
; (default_srtpcipher non-empty OR per-peer srtpcipher non-empty), chan_sofia
; generates an INDEPENDENT FRESH master_key for EACH suite in the offer-list
; via res_srtp->get_random — forensic-grade key separation. Key material
; recovery from one suite cannot decrypt others (MIKEY/DTLS-SRTP convention).
;
; Default OFF preserves shared-key strategy (a) baseline (current behavior;
; the shared-key mode): single 46-byte master_key shared across all suite-lines, with
; per-suite-prefix base64 truncation per RFC 6188 / RFC 7714 keysalt lengths.
; NOTE: shared-key strategy (a) is NOT a security
; flaw — peer picks ONE suite per RFC 4568 §6.1 answer mechanism; unused
; suite-line key material is discarded immediately at answer-acceptance time.
; Per-suite mode adds defense-in-depth for forensic / compliance scenarios
; where unused-key-material-discard timing is auditable.
;
; Memory cost when enabled: ~1.7 KB per active SRTP call (16-slot static
; arrays in struct sdp_crypto: 16 × 46-byte master_key + 16 × 64-byte base64
; encoded). Negligible for typical chan_sofia deployments. Defensive overflow
; gate: if operator cipher_list exceeds MAX_SDP_CRYPTO_SUITES=16, additional
; suites fall back to shared-key with LOG_WARNING (preserves correctness).
;
; [general]-only operator option (no per-peer override; operator-policy is
; global). Reload-required: changes take effect at module reload chan_sofia.so.
;
;srtp_per_suite_keys = no    ; default: shared-key mode (strategy (a))
;srtp_per_suite_keys = yes   ; forensic-grade per-suite-fresh-key mode

;
; Force INVITE digest auth global lockdown override (chan_sofia extension
; — operator-policy-global-security-override;
; no chan_sip equivalent — chan_sip has only per-peer insecure=invite, no
; global override mechanism).
;
; Default 0 = drop-in chan_sip parity baseline. Per-peer `insecure=invite`
; configurations bypass INVITE digest auth for trusted-IP trunks (chan_sip
; semantic preserved). Per-call LOG_NOTICE + AMI InsecureInviteBypass event
; fire on every bypass traversal (chan_sofia extension over chan_sip silent
; bypass — operators see ongoing usage in logs/NMS, not just config-load).
;
; When set 1 = global lockdown override. ALL inbound INVITEs require digest
; auth regardless of per-peer insecure=invite config. When triggered for a
; peer with insecure=invite, LOG_NOTICE fires "force_invite_auth=yes overrides
; per-peer insecure=invite for peer X — auth required" so operator sees
; policy taking effect.
;
; Use cases:
;   * Compliance audit: temporarily disable bypass during scheduled review
;   * Incident response: lock down auth in response to detected attack
;   * Default-deny posture: progressive operator hardening (audit insecure=
;     usage via LOG_NOTICE/AMI events; provision proper SIP auth credentials;
;     replace insecure=invite with secret= over time; final state: no insecure=
;     peers + force_invite_auth=yes for default-deny)
;
; Reload-required: changes take effect at module reload chan_sofia.so.
;
;force_invite_auth = no     ; default: drop-in chan_sip parity (per-peer bypass active)
;force_invite_auth = yes    ; global lockdown (all INVITEs require auth)

;
; Nonce TTL window for digest auth. Default is 3600s so normal long REGISTER
; refresh intervals do not force stale=true on every refresh.
;
; Controls how long an issued nonce remains valid before forced re-challenge.
; Tighter window = stronger replay-window protection but more frequent re-
; auth round-trips. Looser window = fewer round-trips but wider replay window
; for compromised Authorization headers (mitigated by nc-monotonic enforcement
; even within window).
;
; Range guidance:
;   * 30   — strict low-trust networks (public WAN, untrusted clients)
;   * 60   — stricter short-window deployment
;   * 300  — legacy chan_sofia pre-3600 default / chan_sip comparison point
;   * 3600 — DEFAULT, aligned with the normal SIP registration maximum
;
; Operator override via [general] nonce_ttl_seconds=N. Reload-required.
;
;nonce_ttl_seconds = 3600   ; default chan_sofia, avoids stale=true on normal long refreshes
;nonce_ttl_seconds = 60     ; stricter short-window deployment
;nonce_ttl_seconds = 300    ; legacy chan_sofia pre-3600 / chan_sip-comparison

;
; chan_sofia digest auth implementation notes (INVITE digest auth
; work — 23 fixes total).
;
; chan_sofia auth path is strictly more secure than chan_sip baseline across
; REGISTER + INVITE + SUBSCRIBE methods uniformly. Specific improvements:
;
;   1. Constant-time digest comparison (sofia_ct_memcmp helper with
;      volatile + memory barrier; chan_sip uses strncasecmp = vulnerable to
;      timing-attack byte-by-byte hash enumeration)
;   2. /dev/urandom 128-bit nonce (sofia_secure_nonce_gen helper with
;      EINTR retry; chan_sip ast_random 32-bit + PRNG fallback ~weaker)
;   3. RFC 7616 SHA-256 dual-algorithm offer (chan_sip MD5-only)
;   4. SOFIA_INSECURE_INVITE bypass visibility (per-call LOG_NOTICE + AMI
;      InsecureInviteBypass event; chan_sip silent post-config)
;   5. force_invite_auth global lockdown override (no chan_sip equivalent)
;   6. Realm validation (byte-exact strcmp; chan_sip skips this check =
;      multi-tenant cross-realm replay vulnerability)
;   7. sofia_au_get_unq truncation safety (returns NULL on overflow; rejects
;      400; chan_sip silent truncation)
;   8. uri= required (rejects 400 if absent per RFC 2617 §3.2.2)
;   9. md5secret support (chan_sip parity fix; pre-hashed digest secret)
;  10. Algorithm strict-parse (case-insensitive enum; reject unknown 400)
;  11. Timing-equalization helper-level (sofia_emit_timing_equalized_reject
;      helper: dummy 3× SHA-256 + 10-50ms jitter; covers REGISTER +
;      SUBSCRIBE + INVITE + ACL-deny + alwaysauthreject all paths)
;  12. Per-peer algorithm offer (md5secret-only-no-secret peer offered MD5
;      only; closes silent-403 fail-forever case)
;  13. WWW-Authenticate header validation (defense-in-depth charset check)
;  14. Configurable nonce TTL (operator-policy alignment)
;
; Operator action items for production deployment:
;   * Review existing trunk peer configs + add `insecure=invite` for IP-
;     trusted trunks BEFORE deploying this build (auth-required becomes
;     default; trunks without insecure=invite get 401 challenges)
;   * Audit sip show settings post-reload — verify expected operator-policy
;     fields (force_invite_auth, nonce_ttl_seconds, srtp_per_suite_keys)
;   * For high-volume rejection scenarios (DDoS / brute-force probing),
;     pair with fail2ban / firewall rate-limit rules at ingress — sofia_
;     thread is single-threaded; timing-equalization usleep limits server-
;     side throughput to ~33 rejects/sec (acceptable trade-off vs username-
;     enumeration prevention; ingress-level rate-limit complements)
;   * Modern SIP UAs supporting RFC 7616 will auto-pick SHA-256; legacy
;     UAs default MD5 — fully backwards-compatible
;   * For operators currently using `secret=` cleartext: consider migrating
;     to `md5secret=` for hardened config (compromised config file leaks
;     only realm-bound MD5 hash, not cleartext password)

;
; RFC 7616 SHA-256 digest auth algorithm support (chan_sofia
; auth-algorithm-modernization-where-chan_sip-MD5-only;
; no chan_sip equivalent — chan_sip hardcodes algorithm=MD5 throughout
; check_auth at chan_sip.c:15287-15477).
;
; chan_sofia emits dual-algorithm WWW-Authenticate challenge (MD5 + SHA-256) per
; RFC 7616 §3.7 multi-algorithm offer convention. Client picks via algorithm=
; parameter on subsequent Authorization header. Server dispatches digest
; verification based on algorithm enum. Default-when-omitted: MD5 (RFC 2617
; backward-compat preserved).
;
; Strict-parse rules (audit hardening):
;   * algorithm= match is case-INsensitive per RFC 7616 §3.3 (`SHA-256` ≡
;     `sha-256`)
;   * unknown / unoffered algorithm: rejected 400 Bad Request (chan_sofia offers
;     MD5 + SHA-256 only)
;   * default to MD5 only when client OMITS algorithm= entirely
;
; Operator considerations:
;   * No [general] toggle to force-disable SHA-256 — both algorithms always
;     offered; client preference wins
;   * md5secret= per-peer storage is MD5-derived; SHA-256 algorithm path with
;     md5secret-set uses md5secret-derived a1_hash (chan_sip semantic preserved
;     even when algorithm-mismatch — operator-config-honored)
;   * Modern SIP UAs supporting RFC 7616 (Asterisk 18+ res_pjsip clients,
;     freeswitch, kamailio with modern modules) will pick SHA-256
;   * Legacy UAs default to MD5 — backwards-compatible
;
; chan_sofia extension: chan_sip hardcodes algorithm=MD5 in WWW-
; Authenticate emit + check_auth verifier. chan_sofia adds RFC 7616 SHA-256
; alongside MD5. Migration path for operators: no config change needed; SHA-256
; is auto-offered. Future RFC 8760 HKDF deferred (post-RFC-7616 follow-up
; per security delta doc §9).
;
; sip show settings displays "Auth algorithms: MD5, SHA-256" (25th field).

;
; Session timers (RFC 4028) — chan_sip parity (drop-in compat).
; Solves two production problems:
;   1. Stateful firewall/NAT idle timeout (long calls dropped silently when SIP-layer
;      mapping evicts despite RTP keepalive). Periodic Session-Expires re-INVITE
;      keeps SIP-layer state alive.
;   2. Dead-peer detection (crash-mid-call discovery within session-expires/2 interval).
; sofia-sip handles wire mechanics (Session-Expires header, refresh re-INVITE
; scheduling, 422 Session Interval Too Small generation) — chan_sofia just wires config.
; Per-peer session-timers= overrides this default. chan_sip's compiled default is "accept"; the
; values shipped active below mirror the chan_sip sip.conf of a typical trunk-behind-NAT deployment
; (originate + uac), so long calls keep SIP-layer firewall/NAT state alive from the inside.
;
session-timers     = originate ; originate / accept / refuse — chan_sip parity values
session-expires    = 3600      ; Session-Expires seconds (RFC 4028 §4; minimum 90)
session-minse      = 90        ; Min-SE seconds (RFC 4028 §3 floor; reject peer offers smaller)
session-refresher  = uac       ; auto (sofia-sip nua_any_refresher) / uac (we refresh) / uas (peer refreshes)

;
; MWI message-summary defaults (RFC 3842). Per-peer "mailbox = mbox@ctx" lines
; in the [peer] section opt-in to MWI subscription delivery for those mailboxes.
; The peer's UA SUBSCRIBEs Event:message-summary; chan_sofia accepts + sends NOTIFY
; with Messages-Waiting + Voice-Message + Message-Account headers.
;
;mwi_from       =                                       ; From header for MWI NOTIFY (empty -> peer->fromdomain or realm fallback)
;notifymime     = application/simple-message-summary    ; Content-Type for MWI NOTIFY body (RFC 3842). Alias 'notifymimetype' accepted per chan_sip drop-in compat (chan_sip uses verbose form only per chan_sip.c:29685-29686).
;notifymimetype = application/simple-message-summary    ; chan_sip-canonical alias for notifymime (alias acceptance ship); identical effect
;vmexten        = asterisk                              ; user-part of Message-Account URI
;mwi_expiry     = 3600                                  ; default subscription expiry seconds (chan_sip parity)

;
; Outbound proxy — when set, outbound INVITE + REGISTER from chan_sofia
; route through the configured proxy as the next-hop while preserving the
; original Request-URI as the final target (RFC 3261 §16 loose routing).
; Per-peer outboundproxy= in [peer] sections overrides this default; empty
; per-peer value (outboundproxy=) unsets the default for that peer.
;
; Accepted forms (normalized internally to "sip:HOST[:PORT];lr"):
;   outboundproxy = upstream.example.com               ; bare host
;   outboundproxy = upstream.example.com:5060          ; host:port
;   outboundproxy = sip:upstream.example.com:5060;lr   ; full SIP URI
;
; The ;lr (loose-route) param is appended automatically if absent — strict
; routing would rewrite the Request-URI which is the wrong semantics for
; proxy use.
;
;outboundproxy  =

;
; Local SIP domains for ${CHECKSIPDOMAIN(domain)} dialplan function.
; List one or more domains your PBX serves. CHECKSIPDOMAIN(domain) returns
; the domain string if it matches a configured entry, else empty. Multi-line
; allowed; case-insensitive match.
;
;domain = mypbx.example.com
;domain = sip.example.com

;
; SIP register string to register with a remote PBX or provider
; Format: user:password@host[:port]
;
;register => myuser:mypassword@sip.provider.com
;register => test:15121972@192.0.2.47:60000

;
; --- Outbound trunk authentication (capability feature) ---
; chan_sofia answers a 401/407 digest challenge on BOTH its outbound REGISTER (the
; register => lines above) AND its outbound INVITEs (calls placed out through a peer
; trunk). The credentials used are the trunk peer's defaultuser/username + secret
; (for a register => line, the user:password in the directive). No extra config is
; required: if the upstream challenges, chan_sofia automatically re-sends the request
; with an Authorization / Proxy-Authorization header.
;   * Use a PLAINTEXT secret= on the trunk peer. A md5secret= (pre-hashed MD5) CANNOT
;     be used for OUTBOUND digest — the cleartext password is needed to compute the
;     response — so an md5secret-only trunk will not authenticate outbound
;     calls/registrations (md5secret stays fine for INBOUND authentication).
;   * If a single response carries both a WWW-Authenticate (endpoint/registrar) and a
;     Proxy-Authenticate (proxy) challenge, both are answered together.
;
; --- Monitoring outbound registrations: "sip show registry" (CLI) ---
; Lists every register => outbound registration and its current state:
;     Host                          Username          Refresh   State
;     sip.provider.com:5060         myuser            3590      Registered
;     192.0.2.47:60000            test              0         Unregistered (3 attempts)
;   Refresh = seconds until the next refresh (0 when not registered). State is
;   Registered or Unregistered; the "(N attempts)" hint appears when an upstream keeps
;   rejecting the digest (verify the trunk secret). The same data is also available via
;   the AMI SofiaShowRegistry action.
;
; --- Forcing a re-registration: "sip unregister <peer>" (CLI) ---
; Force-expires a DYNAMIC peer's INBOUND registration so the phone must register
; again: clears its contact bindings, marks it unregistered and emits the AMI
; "PeerStatus: Unregistered" event plus the device-state change (so BLF lamps update).
; Operates on in-RAM peers only — a realtime peer's database binding is untouched — and
; refuses to run on an outbound register => trunk (use sip show registry for those).

; ============================================
; Outbound trunk example
; ============================================
;[remote-pbx]
;type=peer
;host=192.0.2.47
;port=60000
;secret=15121972
;md5secret=8a47d6b8c8e8f6a3b9c2d4e7f1a8b3c5  ; (chan_sip parity; chan_sip.c:15415-16). Pre-hashed MD5(user:realm:secret) digest — server config doesn't store cleartext password (operator hardening best-practice). Compute: `printf "user:realm:password" | md5sum` (32 hex chars). When BOTH secret= and md5secret= set, md5secret takes PRECEDENCE per chan_sip parity; LOG_WARNING fires on dual-set ambiguity (recommend operator unset secret= once md5secret= configured). For RFC 7616 SHA-256 paths, md5secret is reused (mismatched-algorithm but operator-config-preserved per chan_sip semantic).
;defaultuser=test
;fromuser=test
;fromdomain=192.0.2.47
;transport=udp                ; chan_sofia: sets the OUTBOUND transport for a STATIC peer (tls/tcp/ws/wss/udp; a comma-list like tls,udp uses the first token; udp default, unknown values fall back to udp). Without it an outbound request to a static TLS/TCP/WS/WSS host silently defaults to UDP. This sets only the peer's outbound default; INBOUND server-accepted transports are controlled per-listener at [general] bindport / tlsbindaddr / wsbindaddr / wssbindaddr, and per-Contact transport is derived from the Contact URL at REGISTER-time. For operators who need transport-based security, separate listeners + IP allowlists (host=<ip> / permit / deny) at the peer level are the real gate.
;disallow=all                ; Reset codec list
;allow=ulaw                  ; Allow specific codecs
;allow=alaw
;context=from-remote
;qualify=yes
;nat=force_rport,comedia

; ============================================
; Local phone example
; ============================================
;[test100]
;type=friend
;host=dynamic
;secret=test100
;context=phones
;disallow=all                ; Reset codec list
;allow=ulaw                  ; Allow specific codecs
;allow=alaw
;callerid="Test 100" <100>
;qualify=yes
;nat=force_rport,comedia     ; force_rport and/or comedia, in any order and whitespace-tolerant; also yes (=force_rport,comedia) / no. Any unrecognized value defaults to force_rport (never silently no-NAT).
;dtmfmode=rfc2833            ; rfc2833 / info / shortinfo / inband / auto (inband uses core tones; shortinfo = SIP INFO with Content-Type application/dtmf, numeric body — chan_sip parity)
;directmedia=no              ; allow direct media re-INVITE (default: no — chan_sip migration safe). Accepts yes/no plus the chan_sip keywords update/nonat/outgoing (all map to enable; chan_sofia has no sub-mode). Alias 'canreinvite' accepted per chan_sip drop-in compat (chan_sip.c:28177 verbatim dual-acceptance).
;canreinvite=no              ; legacy chan_sip alias for directmedia (alias-acceptance ship); identical effect
;busy_on_active=no           ; per-peer override of [general]
;max_contacts=6              ; per-peer override of [general]; range [1, 6]
;callgroup=1                 ; call group(s) this peer belongs to; syntax: "1", "1,3", "1-3,5"
;pickupgroup=1               ; call groups this peer can pick up via *8; same syntax
;permit=192.168.0.0/24       ; per-peer ACL: allow REGISTER + INVITE from this CIDR
;deny=0.0.0.0/0              ; per-peer ACL: combine with permit (default deny then permit specifics)
;encryption=no               ; per-peer SDES-SRTP override; yes -> require RTP/SAVP + a=crypto, else 488
                             ; RECOMMENDATION for trunk-style peers: explicitly set encryption=no
                             ; to override any [general] encryption=yes default. Plain-RTP trunks
                             ; reject a=crypto offer with 488 — without per-peer override, outbound
                             ; trunk calls fail at the SDES-SRTP negotiation step.
;outboundproxy=upstream.example.com:5060   ; outbound INVITE+REGISTER routes via proxy; empty = inherit [general]; outboundproxy= alone unsets inherited
;srtpcipher=AEAD_AES_256_GCM,AES_CM_128_HMAC_SHA1_80    ; srtpcipher: per-peer comma-separated outbound a=crypto cipher preference (RFC 4568 §6.1 multi-line); empty = inherit [general] default_srtpcipher; if both empty, sdp_crypto.c defaults to AES_CM_128_HMAC_SHA1_80
;session-timers=originate                  ; session timers RFC 4028: originate / accept / refuse; per-peer override of [general] default; "originate" recommended for trunks behind stateful firewall/NAT
;session-expires=1800                      ; per-peer Session-Expires seconds; chan_sip parity; minimum 90 per RFC 4028 §3
;session-minse=90                          ; per-peer Min-SE seconds; chan_sip parity; floor 90 per RFC 4028 §3
;session-refresher=uac                     ; per-peer refresher preference auto/uac/uas; "uac" recommended for inside-NAT side so refresh re-INVITE originates from the side that needs to keep firewall state alive
;mailbox=1234                ; MWI: subscribe-trigger source; "1234" defaults to "1234@default" context
;mailbox=1234@phones         ; explicit context form
;mailbox=1234@a,5678@b       ; comma-separated multi-mailbox (per-mailbox NOTIFY emission)
                             ; chan_sofia honors at-most-1 active subscription per peer; new SUBSCRIBE replaces old (terminated;reason=deactivated).
;callingpres=allowed_not_screened ; per-peer presentation override; AST_PRES_* values per [general] callingpres list
;sendrpid=pai                ; per-peer RPID/PAI emission: no / pai / rpid (yes = rpid, chan_sip parity); typical trunk: pai
;trustrpid=yes               ; per-peer trust on inbound PAI/RPID; typical trunk: yes (trusted upstream)
;forceddiversion=34931234567 ; CLI-forward compliance (RFC 5806): force a trunk-owned DID as the diverting party in the outbound Diversion header on FORWARDED (desvio) calls, so the carrier validates the diversion against a number it provisions for this trunk (RULE 2). Emitted ONLY when the channel carries a redirect marker — set REDIRECTING(from-num) or REDIRECTING(reason) in the dialplan before Dial(); a non-forwarded direct call NEVER gets a Diversion. Keep RULE 1 (From=original caller): do NOT overwrite CALLERID(num) and do NOT set fromuser= to the DID. Empty = disabled (legacy data-driven Diversion).
;call-limit=5                ; max simultaneous calls; alias accepted: call_limit
;busylevel=3                 ; return BUSY (486) when 3 calls already in progress
;callcounter=yes             ; shorthand: unlimited tracking + 480 enforcement at hard cap
;allowtransfer=no            ; allowtransfer per-peer parity (chan_sip drop-in): yes (default — accept REFER) / no (reject REFER with 603 Declined (policy)). Hardening: set "no" on untrusted/external trunks to block REFER-abuse vectors (call spam, redirect-to-attacker, premium-rate fraud). chan_sofia extension: AMI TransferRejected event fires on rejection (chan_sip silently logs only).
;allowsubscribe=no           ; allowsubscribe per-peer parity (chan_sip drop-in): yes (default per sip.h:478) / no (reject SUBSCRIBE with 403 Forbidden (policy)). A REQUEST-EVENT gating sibling to allowtransfer. Set "no" on untrusted/external trunks to block subscribe-abuse vectors (presence/MWI scraping, dialog-monitoring). chan_sofia extension: AMI SubscribeRejected event fires on rejection (chan_sip silent baseline).
;buggymwi=yes                ; buggymwi per-peer parity (chan_sip drop-in): no (default — RFC 3842 standard) / yes (Cisco-buggy-stack workaround — omits "(0/0)" tally suffix from Voice-Message NOTIFY body). chan_sip parity sip.h:338 SIP_PAGE2_BUGGY_MWI flag bit + chan_sip.c:13800-13802 verbatim comment "Cisco has a bug in the SIP stack where it can't accept the (0/0) notification". Per-peer-only flag (no [general] default); set yes for Cisco peers exhibiting the bug, leave default no for all standard RFC 3842 phones.
;lockuseragent=yes           ; lockuseragent per-peer parity (chan_sip drop-in security feature): no (default) / yes (lock peer registration to first captured User-Agent string). When yes, the peer's first successful REGISTER captures the User-Agent header into peer->locked_user_agent; subsequent REGISTERs from a different User-Agent string are silently rejected with 401 challenge (chan_sip-faithful AUTH_SECRET_FAILED-equivalent — attacker cannot distinguish UA-mismatch from bad-secret). Hardens against UA-spoofing attacks where an attacker steals credentials but registers from a different SIP client. chan_sip parity sip.h:1268 unsigned short lockuseragent:1 + chan_sip.c:28708-28712 realtime-only parser + chan_sip.c:15839-15843 use-site. chan_sofia extension: extends parser to config-file too (chan_sip realtime-only is parser-quirk; effect-site fires regardless). chan_sofia extension: AMI LockUserAgentReject event fires on rejection (Peer + MatchPolicy + LockedUserAgent + Prefixes + AttemptedUserAgent + RemoteAddr) for NMS UA-spoofing-attack visibility (chan_sip silent baseline).
;lockuseragent_prefixes=Acme SIP-T,Acme GRP ; chan_sofia extension: per-peer comma-separated User-Agent prefix allowlist. Consulted only when lockuseragent=yes. When non-empty, replaces the strict capture-on-first-REGISTER semantic with a vendor-family allowlist: an inbound REGISTER passes when its User-Agent: header starts (case-insensitive) with ANY listed prefix; no match is rejected with the same silent 401 + AMI LockUserAgentReject path (MatchPolicy: prefix-list, Prefixes: <list>). Targets the multi-device-per-peer case (desk phone + softphone on the same credentials) and vendor-family lockdowns (any Acme T-series, any Acme GRP-series). Empty (default) preserves the original strict semantics verbatim. Reload-safe: edit the list in sofia.conf and `module reload chan_sofia.so` — or UPDATE voip_sip_conf.lockuseragent_prefixes + `sip prune realtime peer <name>` — and the new list is effective on the next REGISTER with no restart.
;accountcode=customer42      ; accountcode per-peer parity (chan_sip drop-in): CDR billing-tag propagated to channel->accountcode for per-customer billing. AST_MAX_ACCOUNT_CODE=20 truncation at CDR-write time (cdr.h:73). chan_sip operator scripts copy verbatim. Per-peer-only — no [general] default_accountcode (chan_sip parity); gabpbx-core ast_default_accountcode at cdr.conf level provides cross-channel default if needed.
;mohinterpret=jazz           ; per-peer MOH class for HOLD-side audio; chan_sip parity
;mohsuggest=blues            ; per-peer mohsuggest INBOUND-direction propagation (when this peer holds us, "blues" propagates to bridged channel); OUTBOUND-direction signaling deferred
;language=es                 ; language per-peer parity (chan_sip drop-in): per-peer audio locale propagated to ast_channel.language at sofia_new for prompts/sounds (e.g. en, es, fr, de). Empty (default) inherits [general] language= or gabpbx-core default. chan_sip parity chan_sip.c:28865-28866 verbatim ast_string_field_set + L28447 inheritance. Bounded to channel.h:138 MAX_LANGUAGE=40.
;parkinglot=floor2           ; parkinglot per-peer parity (chan_sip drop-in): per-peer parking-lot routing propagated to ast_channel.parkinglot at sofia_new for Park()/transfer-to-park dialplan operations. Empty inherits [general] parkinglot= ("default" per chan_sip features.h:37 DEFAULT_PARKINGLOT). chan_sip parity chan_sip.c:28890-28891 verbatim ast_string_field_set + L8577 inheritance + L7943-7944 channel propagation.
;defaultip=192.168.1.10      ; defaultip per-peer parity (chan_sip drop-in): fallback IP for host=dynamic peer when not yet registered. Outbound calls before the peer registers route to defaultip; once peer registers src_addr (registration source) takes precedence. Use case: cold-start before registration, or known-fallback for stable upstream gateways. Empty (default) = no fallback (host=dynamic peers fail outbound until registered). chan_sip parity chan_sip.c:28814-28818 verbatim ast_get_ip + L5913-5915 dialog->sa fallback semantic. chan_sofia extension: resolve-fail logs LOG_WARNING + leaves defaddr empty (chan_sip hard-fails entire build_peer alloc).
;maxcallbitrate=128          ; maxcallbitrate per-peer parity (chan_sip drop-in): per-peer SDP video bandwidth ceiling (kbps) emitted as b=CT:%d media-level attribute. Default 384 per sip.h:218 DEFAULT_MAX_CALL_BITRATE; set 0 to omit b=CT line entirely. Use case: bandwidth-constrained WAN trunks or video peers with QoS limits. Audio calls unaffected (b=CT gated inside if (needvideo) per chan_sip.c:12285). chan_sip parity chan_sip.c:28967-28970 verbatim atoi + bounds-clamp.
;
; CID bundle per-peer parity (chan_sip drop-in outbound CID override
; for trunk peers): 5 chan_sip-verbatim keys + 1 chan_sofia extension alias.
; Default empty all 3 fields; channel CID via dialplan CALLERID() takes
; precedence per chan_sip.c:5957 dialog-inheritance semantic
; (peer-CID is base/default — channel CID overrides when set).
;callerid="John Doe" <15554477>  ; combined-form per chan_sip.c:28739-28744 (ast_callerid_split → cid_name + cid_num)
;fullname=John Doe               ; cid_name only per chan_sip.c:28747-28748
;cid_name=John Doe               ; chan_sofia extension: natural-named-field-as-alias for fullname (operator convenience; chan_sip ABSENT)
;cid_number=15554477             ; cid_num only per chan_sip.c:28752-28753
;cid_tag=trunk_eli3              ; per chan_sip.c:28754-28755 — channel-side identifier (Asterisk-internal ast_party_id.tag; NOT SIP From-tag — sofia-sip auto-generates SIP From-tag for dialog uniqueness per RFC 3261 §8.1.1.3)
;trunkname=eli3                  ; per chan_sip.c:28749-28751 — clears cid_name (operator-friendly trunk-naming without identity)
;amaflags=billing                ; amaflags per-peer parity (chan_sip drop-in): per-peer CDR AMA-flags propagated to ast_channel.amaflags at sofia_new for cdr_sqlite3/pgsql/etc. recording. Valid values: "default" / "omit" / "billing" / "documentation" (case-insensitive; see cdr.h ast_cdr_amaflags2int). Empty (default 0) = channel-core default preserved (sofia_new gated on non-zero per chan_sip.c:7947-7948 verbatim). Invalid value → LOG_WARNING + skip-the-bad-key (chan_sip-verbatim semantic). chan_sip parity chan_sip.c:28871-28877 verbatim parser.
;subscribemwi=no                 ; per-peer MWI model (chan_sip parity, default no). no = UNSOLICITED MWI: chan_sofia pushes a message-summary NOTIFY to the registered contact on each REGISTER and on every mailbox-count change, no SUBSCRIBE needed (RFC 3842; Subscription-State: active; sent via nua_method NOTIFY because this sofia-sip fork rejects an out-of-dialog nua_notify). yes = SUBSCRIBE-only: MWI is sent only on an active inbound MWI subscription dialog. A subscribing phone keeps its solicited NOTIFYs and is NOT also pushed unsolicited (no double-notify). Requires a peer mailbox= (see the MWI block above). chan_sip parity chan_sip.c:28902-28903 + sip.h:324 SIP_PAGE2_SUBSCRIBEMWIONLY.
;mwi_subscribe=100@default        ; OUTBOUND MWI WATCHER — chan_sofia as a SUBSCRIBER (DISTINCT from the inbound subscribemwi bool above). When set, after this trunk's REGISTER 200 (register=> trunks) or at load (static-host peers), chan_sofia sends a SUBSCRIBE for Event: message-summary to this peer/trunk and injects the upstream's Voice-Message: N/M (RFC 3842 simple-message-summary) into the LOCAL ast_event MWI cache as <localmailbox>[@context] (context defaults to "default"), so LOCAL phones watching that mailbox light up from an UPSTREAM voicemail server. SUBSCRIBE Expires = [general] mwi_expiry (default 3600s; sofia-sip auto-refreshes). Honors per-peer/[general] outboundproxy (initial Route). A failed INITIAL SUBSCRIBE (transport/DNS error, timeout, 423, or other final nua declined) is retried with backoff (30s→300s); an ESTABLISHED subscription is refreshed by sofia-sip; a TERMINAL auth rejection (bad/missing secret) is NOT retried (fix the secret + sip reload). A Subscription-State: terminated NOTIFY clears the local lamp (new=0/old=0) unless it carries a body, which is honored. Empty = off. NOTE: this is a chan_sofia capability with NO chan_sip equivalent (chan_sip's mailbox=/mwi=> model differs).
;subscribe_event=presence        ; GENERIC OUTBOUND SUBSCRIBE (RFC 6665) — chan_sofia as a SUBSCRIBER for an ARBITRARY event package (DISTINCT from mwi_subscribe above, which is message-summary-only). Format: <event>[;<accept-mime>][;<expires-seconds>]. After this trunk's REGISTER 200 (or at load for static-host peers) chan_sofia SUBSCRIBEs this peer for the named Event package (presence, dialog, reg, conference, presence.winfo, ...) and surfaces each received NOTIFY as the AMI event SofiaEventNotify (fields: SubId = peername:event stable correlation key, Peer, Event, ContentType, SubscriptionState, Reason, Expires, Truncated, BodyBase64 — the raw NOTIFY body base64-encoded, capped at 8KB) plus a LOG NOTICE, WITHOUT interpreting the body. Accept auto-fills the package default (presence→application/pidf+xml, dialog→application/dialog-info+xml, reg→application/reginfo+xml, ...) when omitted; Expires defaults to 3600 (7200 for dialog, RFC 4235). Same lifecycle as mwi_subscribe (outboundproxy Route, reactive auth, failed-initial 30s→300s backoff, sofia-sip-owned refresh, terminated-teardown). Empty = off. v1: peer-only target, one event package per peer, observability surface only (no dialplan/devstate injection yet). Example: subscribe_event=dialog;application/dialog-info+xml;1800
;preferred_codec_only=yes       ; preferred_codec_only per-peer parity (chan_sip drop-in): SDP codec-list narrowing — outbound m=audio offers/answers contain ONLY single most-preferred codec instead of full list. Default no. chan_sip parity chan_sip.c:28922-28923 verbatim ast_set2_flag SIP_PAGE2_PREFERRED_CODEC + sip.h:313 flag bit + L10076 use site. chan_sofia extension: applies narrowing to BOTH initial-INVITE-offer AND response (chan_sip narrows RESPONSE-direction only).
;ignoresdpversion=yes            ; per-peer RFC 3264 §8 o= version handling (chan_sip process_sdp_o parity); overrides the [general] default. no (default) = HONOR the o= version: a re-offer with the same origin + unchanged (<=) session-version is a no-op, preserving the learned media/RTP remote (so a NATed peer's symmetric-RTP public address survives a keepalive re-offer that re-sends the private c=). yes = IGNORE the version and reprocess every inbound SDP unconditionally (escape hatch for UAs that change media without bumping o=). chan_sip parity SIP_PAGE2_IGNORESDPVERSION.
;promiscredir=yes                ; promiscredir per-peer parity (chan_sip drop-in parse-compatibility only). chan_sip semantic: when set + outbound INVITE returns 3xx Moved Temporarily → ast_string_field_build call_forward to "SIP/contact_number@host" format (allows remote peer to redirect outbound call via dialplan call-forward mechanism). Default no = chan_sip IGNORES 3xx Contact (security default; prevents un-trusted 3xx hijacking). chan_sofia nua_r_redirect handler ABSENT (sofia-sip exposes nua_r_redirect event in nua.h:151 but chan_sofia doesn't currently handle it); KNOWN LIMITATION promiscredir=yes operators get parse-clean migration but chan_sofia continues to ignore 3xx regardless. Future-fix path: implement nua_r_redirect handler + 3xx Contact parser + ast_channel.call_forward setter (~80-120 LoC). chan_sip parity chan_sip.c:28173-28175 verbatim parser via handle_common_options + sip.h:251 SIP_PROMISCREDIR (1<<11) flag bit + chan_sip.c:20907-20925 use site at 3xx Contact handler.
;autoframing=yes                 ; autoframing per-peer parity (chan_sip drop-in parse-compatibility only). chan_sip semantic: when set, honor peer-advertised ptime in SDP via ast_codec_pref_setsize for codec packetization size. Default no = chan_sip uses fixed ptime from format prefs. chan_sofia sofia_parse_sdp infrastructure PRESENT but autoframing not implemented today; KNOWN LIMITATION autoframing=yes operators get parse-clean migration but chan_sofia continues to use sofia-sip default ptime negotiation regardless. Future-fix path ~50-70 LoC follow-up. chan_sip parity chan_sip.c:28924-28925 verbatim per-peer parser (DIRECT build_peer NOT handle_common_options) + chan_sip.c:10415 use site at SDP parse + chan_sip.c:12663 use site at SDP generate.
;faxdetect=yes                   ; faxdetect per-peer multi-mode parity (chan_sip drop-in parse-compatibility only). 4-state values: no (default; NONE) / cng (1; CNG tone only) / t38 (2; T.38 reinvite only) / yes or cng,t38 (3; BOTH). chan_sip semantic: detect inband fax CNG via ast_dsp DSP_FEATURE_FAX_DETECT + T.38 reinvite from peer; auto-switch to fax handling. chan_sofia DSP infrastructure PRESENT (inband DTMF) but fax-CNG detection is not yet implemented; T.38 infrastructure ABSENT (a future T.38 enhancement). KNOWN LIMITATION faxdetect=yes/cng/t38 operators get parse-clean migration but chan_sofia continues to ignore CNG + T.38 reinvites regardless. Future-fix ~150-200+ LoC within a future T.38 enhancement. chan_sip parity chan_sip.c:28202-28221 verbatim multi-mode parser via handle_common_options + sip.h:341-344 verbatim 2-bit flag encoding + 5+ use sites L4945+L6282+L8186-8288+L10196.
;timert1=500                     ; timert1 per-peer parity (chan_sip drop-in, implemented at [general] via NTATAG_SIP_T1). RFC 3261 §17.1.1.1 T1 retransmission interval (default 500ms; ≥ 200ms minimum + ≥ t1min floor per chan_sip parity). Per-peer sscanf %30d + triple-clamp + LOG_WARNING + fallback peer->timer_t1 = sofia_cfg.t1min (chan_sip-faithful floor semantic). chan_sip parity chan_sip.c:28941-28946 verbatim DIRECT build_peer parser. Per-peer dynamic override deferred (future item).
;allowoverlap=yes                ; allowoverlap per-peer + [general] parity (chan_sip drop-in, implemented at 3 sites: sofia_process_invite ast_canmatch_extension MATCHMORE 484 emit + sofia_indicate AST_CONTROL_INCOMPLETE case + nua_r_invite 484 status special-case). RFC 3261 §3 digit-by-digit dialing tri-state. Default yes per chan_sip.c:29479 verbatim drop-in critical default. Values: yes (484 Address Incomplete on partial-match) / no (404 Not Found on partial-match) / dtmf (parsed + stored + displayed but treated as fall-through per chan_sip own design at chan_sip.c:23937-23943 verbatim dialplan-deferral comment "For SIP_PAGE2_ALLOWOVERLAP_DTMF it is better to do this in the dialplan using the Incomplete application rather than having the channel driver do it"). chan_sip parity chan_sip.c:28188-28195 verbatim handle_common_options parser + sip.h:318-322 verbatim 2-bit-flag-encoding-at-position-13. chan_sofia 3-site-additive implementation + AMI SIPshowpeer "OverlapDial" (chan_sofia extension over chan_sip AMI silent).
;callbackextension=200           ; callbackextension per-peer parity (chan_sip drop-in, implemented via NUTAG_M_USERNAME at 3 nua_register call sites: chan_sofia.c:9313 auth-challenge re-REGISTER + L12730 qualify-cycle re-REGISTER + L12782 initial-REGISTER inside sofia_do_register). When chan_sofia registers AS A CLIENT to upstream provider (a `register =>` trunk — secret + non-dynamic host AND an explicit [general] register=> line; secret+static-host alone does NOT register), callbackextension overrides the user-portion of the Contact URI advertised in REGISTER. Upstream provider sends inbound calls back to the registered Contact URI; the user-part determines which extension lands in your local dialplan (typically a context entry like exten => 200,1,Goto(incoming,s,1) routes back-calls). chan_sip parity chan_sip.c:28869-28870 verbatim per-peer parser via DIRECT build_peer (chan_sip uses local-var `char callback[256]` at L28578 + auto-builds reg_string + sip_register at L29240-29246 + transmit_register sets p->exten = r->callback at L14267-14269 → set_contact_string state-machine derives Contact user-part). chan_sofia uses sofia-sip native NUTAG_M_USERNAME tag (per nua_tag.c:1955+L1983 verbatim "Username for Contact URI") via TAG_IF gate at all 3 nua_register call sites — chan_sofia uses a sofia-sip native tag instead of a state machine (1-tag implementation vs chan_sip indirect Contact-URI-user-derivation-via-pvt-state machine). chan_sofia extension over chan_sip CLI/AMI silent (chan_sip stores in build_peer local-var + discards never displayed; chan_sofia adds sip show peer "Callback ext: %s" + AMI SIPshowpeer "CallbackExtension: %s" CLI-exposure-where-chan_sip-silent). Empty-default = chan_sip drop-in baseline (no callback registered; Contact URI uses default-user instead). Per-peer-only ship — chan_sip [general] parser absence verified.
;setvar=ACCOUNTCODE=1234         ; setvar per-peer parity (chan_sip drop-in COMBINED setvar+header ship). Per-peer channel-variable injection at sofia_new — variable applied to the inbound/outbound channel via pbx_builtin_setvar_helper, then visible to dialplan as ${ACCOUNTCODE}. MULTI-LINE supported: specify multiple setvar= lines, each appends to peer->chanvars LIFO list (LAST setvar= in config takes precedence on duplicate-name). chan_sip parity chan_sip.c:28953-28954 verbatim per-peer parser via DIRECT build_peer + chan_sip.c:28415-28428 add_var helper (chan_sofia mirror helper sofia_add_var) + chan_sip.c:8007-8010 verbatim sip_new iteration (chan_sofia mirror at sofia_new direct peer iteration — chan_sofia extension via simpler-iteration-vs-chan_sip-3-step-machine; chan_sip copies peer->chanvars → pvt->chanvars at sip_alloc + find_peer; chan_sofia skips both copy steps via direct peer ao2-ref-held lifetime invariant). chan_sip [general] absence verified — NO sofia.conf [general] equivalent. Reload-required: changes take effect at module reload chan_sofia.so.
;header=X-Custom-Tag: trunk-A    ; header per-peer parity (chan_sip drop-in COMBINED setvar+header ship). Per-peer custom SIP header injection at OUTBOUND INVITE/REGISTER assembly — format `header=Header-Name: header-value` with the colon-space separator part of the value. MULTI-LINE supported: specify multiple header= lines, each appends to peer->chanvars list as `__SIPADDHEADERpre%2d=` channel-var (transparent to operator; just write `header=X-Custom-Tag: trunk-A` and chan_sofia handles the prefix internally). chan_sip parity chan_sip.c:28955-28958 verbatim per-peer parser via DIRECT build_peer + chan_sip.c:13160-13187 verbatim outbound __SIPADDHEADER prefix-recognition via 12-char strncasecmp on channel varshead. chan_sofia reuses existing dialplan-apps SIPAddHeader infrastructure at chan_sofia.c:4509 sofia_build_addheader_str absorbs header= seamlessly via channel-var prefix matching (12-char strncasecmp("SIPADDHEADER", 12)) at sofia_call (L4858) → SIPTAG_HEADER_STR injection. ZERO new outbound-builder code needed (existing-infrastructure-leverage). Implementation flow: peer->chanvars __SIPADDHEADERpre1=Name: value entry → sofia_new pbx_builtin_setvar_helper sets channel var → __ inheritance strips underscores → existing sofia_build_addheader_str picks up "SIPADDHEADERpre1" prefix at sofia_call → header emitted in outbound SIP request. chan_sip [general] absence verified. Reload-required: changes take effect at module reload chan_sofia.so.
;timerb=20000                    ; timerb per-peer parity (chan_sip drop-in, implemented at [general] via NTATAG_SIP_T1X64 nua_create). RFC 3261 §17.1.1.2 INVITE transaction timeout (Timer B = 64*T1 default 32000ms; ≥ 200ms minimum per chan_sip parity). Per-peer sscanf %30d + clamp-to-default-on-invalid + LOG_WARNING. chan_sip parity chan_sip.c:28947-28952 verbatim DIRECT build_peer parser. Per-peer dynamic override deferred per the t1min precedent (peer field stored + displayed; NTATAG_SIP_T1X64 nua_create implementation serves global default only).
;progressinband=yes              ; progressinband per-peer parity (chan_sip drop-in tri-state never/no/yes). NEVER (default) = emit 180 only no in-band. YES = emit 180 + force in-band audio per chan_sip.c:7631 verbatim. NO = degrades to NEVER under chan_sofia's partial implementation (KNOWN LIMITATION: chan_sofia lacks SIP_PROGRESS_SENT tracking; full chan_sip NO-state semantic requires ~30 LoC future-fix). chan_sip parity chan_sip.c:28166-28172 verbatim parser via handle_common_options + sip.h:282-285 verbatim 3 macros + chan_sip.c:7616-7637 use site at sip_indicate AST_CONTROL_RINGING. With progressinband=no (NEVER-equivalent intent), chan_sofia honors it on reload.
;rtptimeout=30                   ; rtp-timeout bundle per-peer parity (chan_sip drop-in): drop call after N seconds without inbound RTP. Default 0 = disabled. chan_sip parity chan_sip.c:28927-28930 verbatim sscanf + LOG_WARNING + clamp-to-global. Consumed at sofia_rtp_init via ast_rtp_instance_set_timeout (rtp_engine.h:1671).
;rtpholdtimeout=300              ; rtp-timeout bundle per-peer parity (chan_sip drop-in): same as rtptimeout but for on-hold state. Default 0. chan_sip parity chan_sip.c:28932-28935. Consumed at sofia_rtp_init via ast_rtp_instance_set_hold_timeout (rtp_engine.h:1689).
;rtpkeepalive=60                 ; rtp-timeout bundle per-peer parity (chan_sip drop-in): send keepalive RTP packet every N seconds. Default 0 = disabled. chan_sip parity chan_sip.c:28937-28940. Consumed at sofia_rtp_init via ast_rtp_instance_set_keepalive (rtp_engine.h:1707).

; ============================================
; Peer configuration options reference
; ============================================
;
; --- Identity ---
; type          - peer, user, or friend (friend = both peer and user)
; secret        - authentication password
; defaultuser   - username for outbound auth (defaults to peer name)
; username      - alias for defaultuser
; user          - alias for defaultuser
; callerid      - caller ID string, e.g. "John Doe" <100>
; regexten      - extension to register
;
; --- Network ---
; host          - hostname, IP, or "dynamic" (default: dynamic)
; port          - remote port (default: 5060)
; transport     - sets the OUTBOUND transport for a static peer (tls/tcp/ws/wss/udp;
;                 a comma-list like tls,udp uses the first token; udp default, unknown
;                 values fall back to udp). chan_sofia does not gate per-peer INBOUND
;                 transport: server-accepted transports are controlled per-listener at
;                 [general] bindport / tlsbindaddr / wsbindaddr /
;                 wssbindaddr; per-Contact transport is derived from the Contact URL
;                 scheme at REGISTER-time. Use separate listeners + IP allowlists for
;                 transport-based security.
; nat           - force_rport and/or comedia (any order, whitespace-tolerant), or yes (=both) / no;
;                 an unrecognized value defaults to force_rport (never silent no-NAT)
;
; --- Dialplan ---
; context       - dialplan context for incoming calls
; fromuser      - user to put in From header. When set, it OVERRIDES the URI user
;                 part of the outbound From, winning over the resolved caller-id /
;                 peer callerid (chan_sip.c:12900-12901 parity). Use it to present a
;                 trunk-provisioned identity to a carrier when the peer has no callerid
;                 (or a callerid you must not leak). Only the From URI user is changed —
;                 the display name, presentation, and any RPID/PAI are untouched. Under a
;                 restricted (anonymous) presentation the From stays anonymized but the
;                 user part still becomes fromuser: "Anonymous" <sip:fromuser@anonymous.invalid>.
; fromdomain    - domain to put in From header
; insecure      - port, invite, port,invite (or "very")
;                 NOTE: insecure flag is PARSED but NOT ENFORCED
;                 at runtime — chan_sofia INVITE auth is not implemented today
;                 (REGISTER auth IS implemented; INVITE auth is a separate gap
;                 queued as "INVITE digest auth implementation" task).
;                 Use ACL (permit/deny per-peer) + frontend SIP proxy (Kamailio)
;                 + TLS for inbound INVITE protection. See
;                 doc/realtime_sippeers.txt Known Limitations.
;
; --- Codecs ---
; disallow      - codecs to disallow (use "all" first, then allow selectively)
; allow         - codecs to allow (see codec list below)
;
; Supported audio codecs: ulaw, alaw, gsm, g722, g729 (annexb=no), g723,
;   opus (/48000/2 channels), speex, speex16, ilbc (mode=20), siren7,
;   siren14, g726, g726aal2, g719, slin, slin16, adpcm, lpc10
; Supported video codecs: h264, h263, h263p, h261, vp8, mp4 (all PT >=96, rate 90000)
;
; Static PTs (RFC 3551): ulaw=0, gsm=3, g723=4, alaw=8, g722=9, g729=18
; Dynamic PTs (96+): assigned by RTP engine — opus, speex, ilbc, h264, vp8, etc.
;
; Example:
; disallow=all
; allow=ulaw
; allow=alaw
; allow=g722
; allow=opus
; allow=h264
;
; --- Media ---
; dtmfmode      - rfc2833, info, shortinfo, inband, auto (default: rfc2833)
; directmedia   - yes/no, or the chan_sip keywords update/nonat/outgoing (all enable; default: no)
;                 When yes, after the bridge is up chan_sofia issues a re-INVITE
;                 to each leg with the OTHER peer's RTP host:port so RTP flows
;                 directly between the endpoints (PBX out of the media path).
;                 Auto-disabled when nat=force_rport or nat=comedia is set on
;                 either peer (NAT'd peers advertise unreachable private IPs).
;                 488 Not Acceptable from a peer cleanly falls back to relay mode.
;
; dtmfmode detail:
;   rfc2833  - RFC 4733 telephone-event in the RTP stream (default)
;   info     - out-of-band SIP INFO, application/dtmf-relay
;   shortinfo- SIP INFO, application/dtmf, numeric body (chan_sip parity); an
;              inbound Signal (incl. numeric 10=* / 11=# and hook-flash) is parsed
;   inband   - audio-band tones, detected by the DSP
;   auto     - advertise telephone-event and use RFC 2833 when the far end
;              negotiates it, else fall back to inband DSP detection. The mode is
;              resolved at SDP commit; telephone-event is advertised in the SDP
;              only for the RFC 2833 modes, and the DSP is (re)configured
;              fax-safely when the negotiated mode differs from the configured one.
; The dialplan app SIPDtmfMode(<mode>) re-syncs the DTMF mode on a live channel.
;
; --- Registration ---
; expiresecs    - registration expiry in seconds (default: 120)
;               also accepted: defaultexpiry
;
; --- Qualify ---
; qualify       - yes/no or timeout in ms (default: no)
; qualifyfreq   - qualify interval in seconds (default: 60)
; qualifytimeout - qualify timeout in seconds (default: 3)
;
; --- Multi-device ---
; busy_on_active - yes/no: reject new calls with 486 Busy Here when any
;                  device on this account is already in a call (default: no)
; max_contacts   - max simultaneous registered devices per peer;
;                  range [1, 6], default 6, hard ceiling 6
; encryption     - yes/no: SDES-SRTP per RFC 4568 (default: no);
;                  yes requires RTP/SAVP + a=crypto in offer/answer or 488
;
; --- Identity headers (identity-headers parity) ---
; callingpres    - default presentation (AST_PRES_*); chan_sip parity values:
;                  allowed_not_screened (default), allowed_passed_screen,
;                  allowed_failed_screen, allowed, prohib_not_screened,
; datachannel    - yes/no: accept the WebRTC m=application SCTP DataChannel
;                  (RFC 8831/8841) on the BUNDLE'd audio DTLS (default: no);
;                  REQUIRES webrtc=yes + a usrsctp build, else m=application is
;                  reflected at port 0 (see section (4) above)
; webrtc_video_bundle - yes/no: carry WebRTC video on the BUNDLE'd audio ICE/DTLS
;                  transport (RFC 8843 max-bundle) instead of a separate vrtp
;                  (default: no); REQUIRES webrtc=yes. Off = separate-transport
;                  video (today's behavior)
; flowclose_emit_unregister - yes/no (default no): RFC 5626 flow-close. A
;                  connection-oriented binding (ws/wss/tcp/tls) is ALWAYS removed
;                  the instant its flow (socket) closes — so a closed browser tab
;                  becomes CHANUNAVAIL immediately, without waiting for the
;                  registration to expire (expiry remains the fallback for udp and
;                  for a flow that dies without a close event). This knob only
;                  controls the EXTERNAL side-effects of that removal: no (default)
;                  removes silently (no AMI PeerStatus / BLF / regexten flap — best
;                  for browsers that F5); yes also emits the full unregister
;                  side-effects (accurate BLF/regexten, at a brief flap on reload)
;                  prohib_passed_screen, prohib_failed_screen, prohib, unavailable
; sendrpid       - outbound RPID/PAI emission: no (default), pai (RFC 3325), rpid
; trustrpid      - yes/no: trust inbound PAI/RPID (default: no);
;                  set yes only for trusted upstream proxies / SBCs
; forceddiversion - per-peer DID forced into the outbound Diversion header
;                  (RFC 5806) on forwarded calls, so a carrier validates the
;                  diversion against a trunk-owned number (CLI-forward RULE 2).
;                  Emitted ONLY when the channel carries a redirect marker
;                  (REDIRECTING(from-num) or REDIRECTING(reason) set in dialplan);
;                  never on a direct call. Empty (default) = legacy behaviour
;                  (Diversion only when the redirecting chain already supplies a
;                  number). Keep From = original caller for full compliance.
;                  Readable via SIPPEER(<peer>,forceddiversion).
;
; --- Call-limit (call-limit parity) ---
; callcounter    - yes/no shorthand: yes -> call-limit=INT_MAX (unlimited
;                  tracking, no 480 enforcement); no -> disable (default)
; call-limit     - integer max simultaneous calls per peer; 0 = unlimited
;                  (default). Alias accepted: call_limit (operator-friendly
;                  drop-in form for wiki/forum copy-paste).
; busylevel      - integer soft-cap; outbound returns 486 Busy Here when
;                  inUse >= busy_level (default: 0 = disabled)
;
; ============================================
; T.38 fax UDPTL parity
; ============================================
;
; chan_sofia ships full T.38 fax UDPTL parity per RFC 3362 + ITU-T T.38
; mirroring chan_sip behavior verbatim, validated.
;
; Per-peer T.38 keys (mirror chan_sip.c:28038-28063 verbatim):
;
; t38pt_udptl       - T.38 enable + UDPTL EC mode + per-peer MaxDatagram override.
;                     Comma-separated value list:
;                       no                   - T.38 disabled (default)
;                       yes                  - T.38 enabled with EC = FEC (default EC)
;                       fec                  - T.38 enabled with EC = FEC (explicit)
;                       redundancy           - T.38 enabled with EC = Redundancy
;                       none                 - T.38 enabled with EC = None
;                       maxdatagram=N        - per-peer MaxDatagram override (0+)
;                     Examples:
;                       t38pt_udptl = yes,maxdatagram=1400
;                       t38pt_udptl = redundancy
;                       t38pt_udptl = no
;
; t38pt_usertpsource - yes/no: when peer is NAT'd (force_rport or comedia)
;                      AND t38pt_usertpsource=yes, override UDPTL DESTINATION
;                      address with audio's actual seen RTP remote endpoint
;                      (port still taken from m=image). Default: no.
;                      Mirrors chan_sip.c:28061-28063 SIP_PAGE2_UDPTL_DESTINATION
;                      semantic. Required for T.38 fax over NAT'd peers.
;
; faxdetect          - 4-state (no/cng/t38/cng,t38) — see § faxdetect above
;                      for full operator semantics. Wired
;                      behaviorally to async-goto fax extension on CNG
;                      detection (audio side) OR peer T.38 reINVITE arrival
;                      (signaling side). Closes the KNOWN LIMITATION.
;
; [general] T.38 keys:
;
; t38_maxdatagram      - default T38FaxMaxDatagram override per chan_sip.c:780
; global_t38_maxdatagram - alias for t38_maxdatagram (operator-friendly)
;                        Sentinel `-1` (default) = use built-in 200 bytes.
;                        Positive integer = explicit override.
;                        Per-peer maxdatagram=N sub-option overrides this.
;
; T.38 SIP signaling protection (RFC 3362 §8 + chan_sip.c:24288 verbatim):
;
; chan_sofia arms a 5-second reINVITE-abort timer (sofia_t38_abort callback)
; on T38_PEER_REINVITE entry. If the fax stack does not respond within 5s,
; chan_sofia emits "488 Not Acceptable Here" to the peer + transitions to
; T38_DISABLED. Mirrors chan_sip.c:23396 verbatim semantic. Without this
; timer, peers that fail to ack the 200 OK leave the dialog stuck in
; PEER_REINVITE forever.
;
; chan_sofia extensions over chan_sip:
;
;   (1) sofia-sip-native protocol mechanics:
;       sdp_media_image + sdp_proto_udptl typed enum dispatch (sofia-sip
;       sdp.h:235 + 249) replaces chan_sip raw sscanf("image %30u udptl t38").
;       Type-safe vs string-parsed at the inbound parser.
;
;   (2) AMI T38FaxNegotiation event — chan_sofia extension.
;       chan_sip is SILENT on AMI for T.38
;       state transitions (verified 0 hits manager_event.*T38). chan_sofia
;       emits 11-field event at every state transition (DISABLED/LOCAL_REINVITE/
;       PEER_REINVITE/ENABLED) with EVENT_FLAG_SYSTEM:
;         ChannelType: SIP
;         Channel: <chan_name>
;         Uniqueid: <chan_uniqueid>
;         Peer: SIP/<peer_name>
;         State: <Disabled|LocalReinvite|PeerReinvite|Enabled>
;         RequestResponse: <RequestNegotiate|RequestTerminate|Negotiated|
;                           Terminated|Refused|RequestParms>
;         MaxIfp: <unsigned int>
;         MaxDatagram: <unsigned int>
;         Version: <unsigned int>
;         RateManagement: <transferredTCF|localTCF>
;         EC: <FEC|Redundancy|None>
;       AMI consumers should subscribe for fax flow visibility (NMS
;       integration). chan_sip operators currently have NO AMI visibility
;       into T.38 negotiation transitions.
;
;   (3) chan_sofia covers BOTH fd-attach orderings (sofia_new pre-existing
;       udptl + sofia_parse_sdp lazy-create-after-channel-exists) — chan_sip
;       only attaches at sip_new.
;
;   (4) sofia_get_udptl_peer NULL-guard improvement (race-safety post-pvt
;       destruction).
;
; Operational characteristics:
;
;   * Reload-mid-fax: existing in-flight T.38 channels NOT affected by
;     reload-time peer->faxdetect_mode change. DSP enable is call-setup-time
;     only (mirrors chan_sip behavior). New calls post-reload pick up new
;     setting.
;
;   * AMI T38FaxNegotiation event spam: fires unconditionally on every state
;     transition. Idempotency early-out at sofia_change_t38_state (chan_sip.c
;     :5772-5773 verbatim) prevents same-state duplicate emits. Under reload-
;     mid-fax or rapid REINVITE/CANCEL races, AMI consumers may see duplicate
;     state transitions — design-preserved-vs-chan_sip.
;
; Test infrastructure for live-fax verification:
;   (a) spandsp soft-fax (sendfax/recvfax CLI from spandsp-utils package)
;   (b) hardware fax + ATA (a SIP analog telephone adapter)
;   (c) Asterisk-with-chan_sip+spandsp peer for fork-test (chan_sofia ↔
;       chan_sip T.38 negotiation interop validation)
;
; Examples:
;
; ; Per-peer T.38 enable with FEC EC + 1400-byte max datagram:
; ;   t38pt_udptl = yes,maxdatagram=1400
; ;   faxdetect = cng,t38
;
; ; Per-peer NAT'd T.38 (peer behind NAT — symmetric-RTP UDPTL destination):
; ;   nat = force_rport
; ;   t38pt_udptl = yes
; ;   t38pt_usertpsource = yes
; ;   faxdetect = t38
;
; ; [general] T.38 default MaxDatagram = 1500 (e.g. matching local MTU):
; ;   t38_maxdatagram = 1500
;
;t38pt_udptl = no                 ; default — T.38 disabled
;t38pt_usertpsource = no          ; default — use SDP c= for UDPTL destination
;t38_maxdatagram = -1             ; default — use built-in 200-byte default
